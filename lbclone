# --update-core: Core-Update aufs neueste Release, nachdem der Clone vollständig eingespielt ist
apply_step_R11C() {
	[ "$(state_get UPDATE_CORE)" = 1 ] || return 0
	log_info "Core-Update auf das neueste Release (--update-core)"
	"$(lbb_p "$META_LB_HOMEDIR")/sbin/loxberryupdatecheck.pl" querytype=release update=1 nobackup=1 2>&1 | lbb_output_always
	if [ "${PIPESTATUS[0]}" != 0 ]; then
		log_warn "Core-Update meldete Fehler (Log: $LBB_LOGFILE)."
