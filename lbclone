# Perl-Teil der Plugin-Logik (decide | pick | version), per "perl -" aus diesem Heredoc
_lbb_perl_code() {
	cat <<'LBB_PERL'
# Plugin-Logik für lbclone: Entscheidung, Kanalwahl, Versionsabfrage.
# Liest die Plugin-Datenbank nur – geschrieben wird sie ausschließlich von plugininstall.pl.
use strict;
use warnings;
use JSON::PP;
use Getopt::Long qw(GetOptionsFromArray);
# LoxBerry::System erst in pick_channel laden: decide --meta muss auch auf einem frischen
# DietPi ohne LoxBerry-Libs laufen (restore --dry-run, info).

my $cmd = shift @ARGV // '';
exit cmd_decide(@ARGV)  if $cmd eq 'decide';
exit cmd_pick(@ARGV)    if $cmd eq 'pick';
exit cmd_version(@ARGV) if $cmd eq 'version';
print STDERR "usage: $0 decide|pick|version ...\n";
exit 2;

sub read_json {
	my $f = shift;
	open my $fh, '<', $f or die "$f: $!\n";
	local $/;
	my $d = decode_json(<$fh>);
	close $fh;
	return $d;
}

# Plugins als Hash md5 → {folder, name, version, autoupdate, has_release, has_prerelease}
sub load_plugins {
	my ($db, $meta) = @_;
	my %p;
	if ($meta) {
		for my $e (@{ read_json($meta)->{plugins} // [] }) {
			$p{ $e->{md5} } = { %$e, has_release => $e->{has_release} ? 1 : 0, has_prerelease => $e->{has_prerelease} ? 1 : 0 };
		}
	} else {
		my $d = read_json($db);
		for my $md5 (keys %{ $d->{plugins} // {} }) {
			my $e = $d->{plugins}{$md5};
			$p{$md5} = {
				folder => $e->{folder}, name => $e->{name}, version => $e->{version}, autoupdate => $e->{autoupdate},
				has_release => (($e->{releasecfg} // '') ne '') ? 1 : 0,
				has_prerelease => (($e->{prereleasecfg} // '') ne '') ? 1 : 0,
			};
		}
	}
	return \%p;
}

sub decide_one {
	my ($au, $hasrel, $haspre, $force, $none, $skipped, $all) = @_;
	return ('skip', '-') if $skipped;
	return ('keep', '-') if $none;
	# Architekturwechsel: alles mit Download-Adresse neu installieren, unabhängig von der Stufe
	if ($all) {
		return ('reinstall', 'release') if $hasrel && $au ne '4';
		return ('reinstall', 'auto') if $hasrel || $haspre;
		return ('nourl', '-');
	}
	return ('keep', '-') if $au eq '0';
	return ('nourl', '-') if !$hasrel && !$haspre;
	if ($au eq '3') {
		return $hasrel ? ('reinstall', 'release') : ('nourl', '-');
	}
	return ('reinstall', 'auto') if $au eq '4';
	if ($au eq '1' || $au eq '2') {
		return ('keep', '-') unless $force;
		return $hasrel ? ('reinstall', 'release') : ('nourl', '-');
	}
	return ('keep', '-');
}

sub cmd_decide {
	my @a = @_;
	my ($db, $meta, $force, $none, $all, @skip);
	GetOptionsFromArray(\@a, 'db=s' => \$db, 'meta=s' => \$meta, 'force' => \$force, 'none' => \$none, 'all' => \$all, 'skip=s' => \@skip) or return 2;
	return 2 unless $db || $meta;
	my %skip = map { $_ => 1 } @skip;
	my $p = load_plugins($db, $meta);
	for my $md5 (sort { ($p->{$a}{folder} // '') cmp ($p->{$b}{folder} // '') } keys %$p) {
		my $e = $p->{$md5};
		my $au = (defined $e->{autoupdate} && $e->{autoupdate} ne '') ? "$e->{autoupdate}" : '0';
		my ($dec, $mode) = decide_one($au, $e->{has_release}, $e->{has_prerelease}, $force, $none, $skip{ $e->{folder} // '' }, $all);
		print join("\t", $md5, $e->{folder} // '', $e->{name} // '', $e->{version} // '', $au, $dec, $mode), "\n";
	}
	return 0;
}

# release.cfg / prerelease.cfg: Abschnitt [AUTOUPDATE] mit VERSION und ARCHIVEURL
sub read_cfg {
	my $f = shift;
	return undef unless $f && -s $f;
	open my $fh, '<', $f or return undef;
	my %h;
	my $sec = '';
	while (my $l = <$fh>) {
		$l =~ s/\r?\n$//;
		next if $l =~ /^\s*(?:[#;]|$)/;
		if ($l =~ /^\s*\[(.+?)\]\s*$/) { $sec = uc $1; next; }
		if ($sec eq 'AUTOUPDATE' && $l =~ /^\s*([^=]+?)\s*=\s*(.*?)\s*$/) {
			my ($k, $v) = (uc $1, $2);
			$v =~ s/^"(.*)"$/$1/;
			$h{$k} = $v;
		}
	}
	close $fh;
	return ($h{VERSION} && $h{ARCHIVEURL}) ? \%h : undef;
}

# Regel wie pluginsupdate.pl ab Z. 291, aber gleiche Version ist erlaubt, ältere nicht.
sub pick_channel {
	my ($inst, $rel, $pre) = @_;
	require LoxBerry::System;
	my $cr = $rel ? LoxBerry::System::plugin_version_compare($rel->{VERSION}, $inst) : undef;
	my $cp = $pre ? LoxBerry::System::plugin_version_compare($pre->{VERSION}, $inst) : undef;
	my $rgt = defined $cr && $cr == 1;
	my $pgt = defined $cp && $cp == 1;
	if ($rgt || $pgt) {
		if ($rgt && $pgt) {
			return LoxBerry::System::plugin_version_has_prerelease($inst) ? 'prerelease' : 'release';
		}
		return $rgt ? 'release' : 'prerelease';
	}
	return 'release'    if defined $cr && $cr == 0;
	return 'prerelease' if defined $cp && $cp == 0;
	return undef;
}

sub cmd_pick {
	my @a = @_;
	my ($mode, $inst, $relf, $pref);
	GetOptionsFromArray(\@a, 'mode=s' => \$mode, 'installed=s' => \$inst, 'release=s' => \$relf, 'prerelease=s' => \$pref) or return 2;
	return 2 unless $mode && defined $inst;
	my $rel = read_cfg($relf);
	my $pre = $mode eq 'auto' ? read_cfg($pref) : undef;
	my $type = pick_channel($inst, $rel, $pre) or return 3;
	my $c = $type eq 'release' ? $rel : $pre;
	print join("\t", $type, $c->{VERSION}, $c->{ARCHIVEURL}), "\n";
	return 0;
}

sub cmd_version {
	my @a = @_;
	my ($db, $md5);
	GetOptionsFromArray(\@a, 'db=s' => \$db, 'md5=s' => \$md5) or return 2;
	my $v = read_json($db)->{plugins}{$md5}{version};
	return 3 unless defined $v;
	print "$v\n";
	return 0;
}
LBB_PERL
}

# ============================================================ Kommandozeile

usage() {
	cat <<'EOF'
lbclone create --output <verzeichnis> [--exclude-plugin-data <folder>:<pfad>] [--no-logs]
                     [--stop-service <name>] [--compress 7z|zip|gz] [--encrypt --passphrase-file <datei>]
                     [--config <datei>] [--dry-run]
lbclone apply [--input <clone>] [--passphrase-file <datei>] [--force-plugin-reinstall]
                     [--no-plugin-reinstall] [--skip-plugin <folder>] [--skip-install]
                     [--allow-core-mismatch] [--github-auth <user:token>] [--no-reboot]
                     [--hostname <name>] [--lbname <LoxBerry-Name>] [--update-core] [--dry-run]
lbclone apply --resume
lbclone info    [--input <clone>] [--passphrase-file <datei>]
lbclone verify  [--input <clone>] [--passphrase-file <datei>]

<clone> ist das ganze Archiv (.7z, .zip, .tar.gz) oder das entpackte loxberry.tar[.gpg].
Ohne --input nimmt lbclone das loxberry.tar[.gpg], das neben ihm liegt.

lbclone config-example   Vorlage für $LBHOMEDIR/config/system/lbclone.cfg ausgeben

Alle Kommandos: -v|--verbose  sehr gesprächige Ausgabe (Schritte, Befehle, Dateilisten)
EOF
}

lbb_main() {
	cmd="${1:-}"
	shift || true

	# Interne bzw. einfache Kommandos ohne Optionsauswertung
	case "$cmd" in
		-h|--help|help) usage; exit 0 ;;
		'') usage; exit 2 ;;
		__plugins) _lbb_perl "$@"; exit $? ;;
		config-example) _lbb_conf_example; exit 0 ;;
	esac

	# Konfigurationsdatei zuerst lesen, damit die Kommandozeile sie überschreibt
	if [ "$cmd" = create ]; then
		_cfg=""
		_prev=""
		for _a in "$@"; do
			[ "$_prev" = --config ] && _cfg="$_a"
			_prev="$_a"
		done
		if [ -z "$_cfg" ]; then
			_lb="$(lbb_lbhomedir)"
			if [ -n "$_lb" ] && [ -r "$(lbb_p "$_lb")/config/system/lbclone.cfg" ]; then
				_cfg="$(lbb_p "$_lb")/config/system/lbclone.cfg"
			fi
		fi
		[ -n "$_cfg" ] && lbb_load_config "$_cfg"
	fi

	LBB_PASSFILE="-"
	LBB_ENCRYPT=0
	LBB_SKIP_PLUGINS=()
	while [ $# -gt 0 ]; do
		case "$1" in
			--output) LBB_OUTPUT="$2"; shift ;;
			--input) LBB_INPUT="$2"; shift ;;
			--passphrase-file) LBB_PASSFILE="$2"; shift ;;
			--encrypt) LBB_ENCRYPT=1 ;;
			--exclude-plugin-data) LBB_PLUGIN_EXCLUDES+=("$2"); shift ;;
			--no-logs) LBB_NO_LOGS=1 ;;
			--stop-service) LBB_STOP_SERVICES+=("$2"); shift ;;
			--compress) LBB_COMPRESS="$2"; shift ;;
			--config) LBB_CONFIG="$2"; shift ;;
			--dry-run) LBB_DRY_RUN=1 ;;
			--force-plugin-reinstall) LBB_FORCE_PLUGIN_REINSTALL=1 ;;
			--no-plugin-reinstall) LBB_NO_PLUGIN_REINSTALL=1 ;;
			--skip-plugin) LBB_SKIP_PLUGINS+=("$2"); shift ;;
			--skip-install) LBB_SKIP_INSTALL=1 ;;
			--allow-core-mismatch) LBB_ALLOW_CORE_MISMATCH=1 ;;
			--github-auth) LBB_GITHUB_AUTH="$2"; shift ;;
			--hostname) LBB_NEW_HOSTNAME="$2"; shift ;;
			--lbname) LBB_NEW_LBNAME="$2"; shift ;;
			--update-core) LBB_UPDATE_CORE=1 ;;
			--no-reboot) LBB_NO_REBOOT=1 ;;
			--resume) LBB_RESUME=1 ;;
			-v|--verbose) LBB_VERBOSE=1 ;;
			-h|--help) usage; exit 0 ;;
			*) usage >&2; die 2 "Unbekannte Option: $1" ;;
		esac
		shift
	done

	if [ "$cmd" = create ]; then
		if [ "$LBB_ENCRYPT" = 1 ] && [ "$LBB_PASSFILE" = "-" ]; then
			die 2 "--encrypt braucht --passphrase-file."
		fi
		[ "$LBB_ENCRYPT" = 1 ] || LBB_PASSFILE="-"
	fi

	# Ohne --input: das loxberry.tar neben dem entpackten lbclone-Ordner
	if [ -z "${LBB_INPUT:-}" ] && [ "${LBB_RESUME:-0}" != 1 ]; then
		case "$cmd" in
			apply|info|verify)
				for _f in "$(dirname "$LBB_SELF")/loxberry.tar" "$(dirname "$LBB_SELF")/loxberry.tar.gpg"; do
					if [ -r "$_f" ]; then
						LBB_INPUT="$(readlink -m "$_f")"
						break
					fi
				done
				;;
		esac
	fi

	case "$cmd" in
		create) create_main ;;
		apply) apply_main ;;
		info) info_main ;;
		verify) verify_main ;;
		*) usage >&2; die 2 "Unbekanntes Kommando: ${cmd:-<leer>}" ;;
	esac
	lbb_final_exit
}

# Nur ausführen, wenn die Datei aufgerufen und nicht per "source" geladen wird
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	lbb_main "$@"
fi
