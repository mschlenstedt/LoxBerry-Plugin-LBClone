# LoxBerry-Installer finden, aufrufen und prüfen (SPEC 6.0).

: "${LBB_INSTALLER_REPO:=https://raw.githubusercontent.com/mschlenstedt/Loxberry_Installer/main}"
: "${LBB_RELEASE_API:=https://api.github.com/repos/mschlenstedt/Loxberry/releases/tags}"
: "${LBB_INSTALLER_NONINTERACTIVE:=0}"
: "${LBB_INSTALLER_API:=https://api.github.com/repos/mschlenstedt/Loxberry_Installer/commits}"

# Commit von main, aus dem das Installer-Skript stammt (fürs Log)
installer_commit() {
	local -a auth=()
	mapfile -t auth < <(_installer_auth)
	curl -fsSL --max-time 30 "${auth[@]}" "$LBB_INSTALLER_API?path=$1&per_page=1" 2>/dev/null \
		| jq -r '.[0].sha // empty' 2>/dev/null | grep . || echo unbekannt
}

installer_script_name() {
	printf 'install_%s_v%s.sh\n' "$1" "${2%%.*}"
}

installer_url() {
	printf '%s/%s\n' "$LBB_INSTALLER_REPO" "$1"
}

_installer_auth() {
	if [ -n "${LBB_GITHUB_AUTH:-}" ]; then
		printf '%s\n' -u "$LBB_GITHUB_AUTH"
	fi
}

installer_available() {
	curl -fsIL --max-time 30 "$(installer_url "$1")" > /dev/null
}

installer_release_exists() {
	local -a auth=()
	mapfile -t auth < <(_installer_auth)
	curl -fsL --max-time 30 "${auth[@]}" "$LBB_RELEASE_API/$1" > /dev/null
}

installer_run() {
	local script="$1" ver="$2" dir="$3" f
	local -a args=(-t "$ver") auth=()
	f="$dir/$script"
	mkdir -p "$dir"
	curl -fsSL --max-time 120 -o "$f" "$(installer_url "$script")" || return 1
	mapfile -t auth < <(_installer_auth)
	args+=("${auth[@]}")
	if [ "$LBB_INSTALLER_NONINTERACTIVE" = 1 ]; then
		args+=(--non-interactive)
	fi
	TERM=dumb bash "$f" "${args[@]}" < /dev/null
}

installer_verify() {
	local ver="$1" home="$2" lbhome have
	lbhome="$(lbb_lbhomedir)"
	if [ "$lbhome" != "$home" ]; then
		log_err "Nach der Installation ist LBHOMEDIR '$lbhome', erwartet '$home'."
		return 1
	fi
	have="$(jq -r '.Base.Version // empty' "$(lbb_p "$lbhome")/config/system/general.json" 2>/dev/null)"
	if [ "$have" != "$ver" ]; then
		log_err "Installiert ist LoxBerry '$have', erwartet $ver."
		return 1
	fi
}

# ============================================================ plugins

# Plugin-Phase (SPEC 6.2, 6.3). Der Restore liest die Plugin-Datenbank nur.

_lbb_perl() {
	local lbhome
	lbhome="${LBB_LBHOME:-$(lbb_lbhomedir)}"
	LBHOMEDIR="$(lbb_p "${lbhome:-/nonexistent}")" \
	PERL5LIB="${LBB_PERL5LIB:-$(lbb_p "$lbhome")/libs/perllib}" \
		perl <(_lbb_perl_code) "$@"
}

# plugins_decide (--db <datei> | --meta <meta.json>) → md5 folder name version autoupdate decision mode
plugins_decide() {
	local -a args=(decide "$@")
	local s
	[ "${LBB_FORCE_PLUGIN_REINSTALL:-0}" = 1 ] && args+=(--force)
	[ "${LBB_NO_PLUGIN_REINSTALL:-0}" = 1 ] && args+=(--none)
	[ "${LBB_ARCH_CHANGE:-0}" = 1 ] && args+=(--all)
	for s in "${LBB_SKIP_PLUGINS[@]}"; do
		args+=(--skip "$s")
	done
	_lbb_perl "${args[@]}"
}

: "${LBB_REPORT:=}"

_report() {
	if [ -n "$LBB_REPORT" ]; then
		printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$LBB_REPORT"
	fi
}

plugin_reinstall_one() {
	local lbhome="$1" md5="$2" folder="$3" version="$4" mode="$5" work="$6"
	local shadow live d relurl preurl pick type pver url rc now
	shadow="$(lbb_p "$lbhome")/data/system/plugindatabase.json-"
	live="$(lbb_p "$lbhome")/data/system/plugindatabase.json"
	d="$work/$folder"
	rm -rf "$d"
	mkdir -p "$d"

	relurl="$(jq -r --arg m "$md5" '.plugins[$m].releasecfg // ""' "$shadow")"
	preurl="$(jq -r --arg m "$md5" '.plugins[$m].prereleasecfg // ""' "$shadow")"
	if [ -n "$relurl" ]; then
		lbb_logged curl -fsSL --max-time 60 -o "$d/release.cfg" "$relurl" || rm -f "$d/release.cfg"
	fi
	if [ "$mode" = auto ] && [ -n "$preurl" ]; then
		lbb_logged curl -fsSL --max-time 60 -o "$d/prerelease.cfg" "$preurl" || rm -f "$d/prerelease.cfg"
	fi
	if [ ! -s "$d/release.cfg" ] && [ ! -s "$d/prerelease.cfg" ]; then
		log_err "$folder: Versionsdatei des Plugins nicht ladbar: ${relurl:-$preurl} – das Plugin bleibt im zurückgespielten Stand."
		_report "$folder" FEHLER "Versionsdatei nicht ladbar (${relurl:-$preurl})"
		return 1
	fi
	if ! pick="$(_lbb_perl pick --mode "$mode" --installed "$version" --release "$d/release.cfg" --prerelease "$d/prerelease.cfg")"; then
		log_err "$folder: angebotene Version ist älter als die installierte $version – das Plugin bleibt im zurückgespielten Stand."
		_report "$folder" FEHLER "keine Version ab $version angeboten"
		return 1
	fi
	IFS=$'\t' read -r type pver url <<< "$pick"
	if ! lbb_logged curl -fsSL --max-time 600 -o "$d/plugin.zip" "$url"; then
		log_err "$folder: Plugin-Archiv nicht ladbar: $url – das Plugin bleibt im zurückgespielten Stand."
		_report "$folder" FEHLER "Download ($url)"
		return 1
	fi

	log_info "$folder: installiere $pver ($type) über plugininstall.pl"
	"$(lbb_p "$lbhome")/sbin/plugininstall.pl" action=autoupdate pid="$md5" file="$d/plugin.zip" \
		< /dev/null 2>&1 | lbb_output_always
	rc="${PIPESTATUS[0]}"
	rm -f "$d/plugin.zip"
	if [ "$rc" != 0 ]; then
		log_err "$folder: Installation fehlgeschlagen (plugininstall.pl, Exitcode $rc; Ausgabe siehe oben und im Log $LBB_LOGFILE)."
		_report "$folder" FEHLER "Installation (Exitcode $rc)"
		return 2
	fi
	now="$(_lbb_perl version --db "$live" --md5 "$md5")"
	if [ "$now" != "$pver" ]; then
		log_err "$folder: nach der Installation Version $now, erwartet $pver."
		_report "$folder" FEHLER "Versionsprüfung ($now statt $pver)"
		return 3
	fi
	log_ok "$folder: $version -> $pver ($type)"
	_report "$folder" OK "$version -> $pver ($type)"
	return 0
}

plugins_reinstall_all() {
	local lbhome="$1" work="$2" failed=0
	local md5 folder name version au dec mode shadow
	shadow="$(lbb_p "$lbhome")/data/system/plugindatabase.json-"
	mkdir -p "$work"
	# Trenner \037 statt Tab: Tab ist für read Leerraum und fasst leere Felder zusammen
	while IFS=$'\037' read -r -u 3 md5 folder name version au dec mode; do
		case "$dec" in
			reinstall)
				plugin_reinstall_one "$lbhome" "$md5" "$folder" "$version" "$mode" "$work" || failed=1
				;;
			nourl)
				log_warn "$folder: autoupdate=$au, aber keine URL — nur Zustands-Restore."
				_report "$folder" nourl "autoupdate=$au"
				;;
			*)
				log_info "$folder: $dec (autoupdate=$au)"
				_report "$folder" "$dec" "autoupdate=$au"
				;;
		esac
	done 3< <(LBB_LBHOME="$lbhome" plugins_decide --db "$shadow" | tr '\t' '\037')
	if [ "$failed" = 1 ]; then
		log_warn "Mindestens ein Plugin wurde nicht neu installiert (siehe Bericht)."
		return 1
	fi
	return 0
}

# ============================================================ create

# Ablauf "lbclone create" (SPEC 7).

# Diese Quellen legt install_trixie_v4.sh selbst an (Z. 359, 370, 376)
LBB_INSTALLER_SOURCES="sury-php.sources yarn.list cloudflared.list"

_BACKUP_STOPPED=()
# Arbeitsordner global, damit die EXIT-Falle ihn nach dem Ende der Funktion noch kennt
_LBB_WORK=""
# Zwischenablage für Datenbank-Dumps auf dem Zielmedium (nicht im tmpfs /tmp)
_LBB_STAGE=""
# Archiv, das noch nicht fertig geprüft ist – wird bei Abbruch gelöscht
_LBB_OUT=""

# Mosquitto schreibt seine Datenbank auf SIGUSR1 (mosquitto(8)), atomar über mosquitto.db.new
_create_flush_mosquitto() {
	local pid db before i
	pid="$(systemctl show -p MainPID --value mosquitto 2>/dev/null)"
	db="$(lbb_p /var/lib/mosquitto/mosquitto.db)"
	if ! [ "${pid:-0}" -gt 0 ] 2>/dev/null; then
		log_info "mosquitto läuft nicht; Datenbank wird so gesichert, wie sie ist."
		return 0
	fi
	before="$(stat -c %.9Y "$db" 2>/dev/null || echo 0)"
	kill -USR1 "$pid" || { log_warn "mosquitto (PID $pid) nahm SIGUSR1 nicht an."; return 0; }
	for i in $(seq 1 50); do
		if [ "$(stat -c %.9Y "$db" 2>/dev/null || echo 0)" != "$before" ]; then
			return 0
		fi
		sleep 0.2
	done
	log_warn "mosquitto hat seine Datenbank nicht innerhalb von 10 s geschrieben; gesichert wird der letzte Stand."
}

# MariaDB im laufenden Betrieb konsistent sichern (InnoDB: --single-transaction, keine Dateikopie)
_create_dump_mariadb() {
	local stage="$1"
	systemctl is-active --quiet mariadb || return 0
	command -v mariadb-dump > /dev/null || { log_warn "mariadb läuft, aber mariadb-dump fehlt – Datenbank wird nicht gesichert."; return 0; }
	mkdir -p "$stage/dumps"
	log_info "Sichere MariaDB per mariadb-dump (ohne Stopp)"
	if ! ( umask 077; mariadb-dump --single-transaction --all-databases --routines --events > "$stage/dumps/mariadb.sql" ); then
		log_warn "mariadb-dump fehlgeschlagen – die Datenbank fehlt im Backup."
		rm -f "$stage/dumps/mariadb.sql"
	fi
}

_create_restart_services() {
	local s
	for s in "${_BACKUP_STOPPED[@]}"; do
		[ -n "$s" ] || continue
		systemctl start "$s" || log_warn "Dienst $s ließ sich nicht starten."
	done
	_BACKUP_STOPPED=()
}

_create_stop_service() {
	# Was nicht läuft, wird weder gestoppt noch hinterher gestartet
	if ! systemctl is-active --quiet "$1"; then
		log_info "Dienst $1 läuft nicht – nichts zu stoppen."
		return 0
	fi
	if systemctl stop "$1"; then
		_BACKUP_STOPPED+=("$1")
	else
		log_warn "Dienst $1 ließ sich nicht stoppen."
	fi
}

create_build_meta() {
	local work="$1" lbhome="$2" m="$1/meta" f name ver arch deb
	local -a pats=()
	mkdir -p "$m/apt/sources.list.d" "$m/apt/keyrings" "$m/apt/preferences.d" "$m/apt/trusted.gpg.d" "$m/apt/debs"

	collect_manual_packages <(_lbb_conf_packages_exclude) > "$m/apt/manual.txt"
	collect_holds > "$m/apt/holds.txt"

	for f in "$(lbb_p /etc/apt/sources.list.d)"/*; do
		[ -f "$f" ] || continue
		case " $LBB_INSTALLER_SOURCES " in *" ${f##*/} "*) continue ;; esac
		cp -a "$f" "$m/apt/sources.list.d/"
		grep -ohiE 'signed-by[:=] *[^] ]+' "$f" | sed -E 's/^signed-by[:=] *//I' | while IFS= read -r deb; do
			if [ -f "$(lbb_p "$deb")" ]; then
				mkdir -p "$m/apt/keyrings$(dirname "$deb")"
				cp -a "$(lbb_p "$deb")" "$m/apt/keyrings$deb"
			fi
		done
	done
	cp -a "$(lbb_p /etc/apt/preferences.d)"/. "$m/apt/preferences.d/" 2>/dev/null
	for f in "$(lbb_p /etc/apt/trusted.gpg.d)"/*; do
		[ -f "$f" ] || continue
		if ! dpkg_owned_paths /etc/apt/trusted.gpg.d/ | grep -qxF "${f#"$LBB_ROOT"}"; then
			cp -a "$f" "$m/apt/trusted.gpg.d/"
		fi
	done

	mapfile -t pats < <(lbb_read_patterns <(_lbb_conf_packages_exclude))
	: > "$m/apt/local-packages.txt"
	collect_local_packages | while IFS=$'\t' read -r name ver arch; do
		if lbb_match_any "$name" "${pats[@]}"; then
			continue
		fi
		if deb="$(find_deb_for "$name" "$ver" "$arch" "$(lbb_p /var/cache/apt/archives)" "$(lbb_p "$lbhome")/data/system/install")"; then
			cp -a "$deb" "$m/apt/debs/"
			printf '%s\t%s\t%s\tgefunden\n' "$name" "$ver" "$arch" >> "$m/apt/local-packages.txt"
		else
			printf '%s\t%s\t%s\tfehlt\n' "$name" "$ver" "$arch" >> "$m/apt/local-packages.txt"
		fi
	done

	collect_dietpi_software > "$m/dietpi-software.txt"
	collect_user_groups loxberry > "$m/groups.txt"
	collect_extra_users > "$m/users.txt"
	( umask 077; collect_passwd_hashes > "$m/passwd-hashes.txt" )
	collect_etc_symlinks "$lbhome" > "$m/etc-symlinks.txt"
	printf '%s\n' "$META_HOSTNAME" > "$m/hostname"
	cat "$(lbb_p /etc/timezone)" > "$m/timezone" 2>/dev/null
}

create_build_lists() {
	local work="$1" lbhome="$2" rel="${2#/}" e folder path out_abs root_abs ref
	{
		printf '%s\n' "$rel" usr/local
		ref="$(lbb_p "$lbhome")/packages${META_OS_VERSION_ID%%.*}.txt"
		# Fehlt die Liste, warnt create_main (hier in der Pipeline ginge der Warnungszähler verloren)
		if [ -r "$ref" ]; then
			collect_var_lib_dirs "$work/meta/apt/manual.txt" "$ref"
		fi
		collect_optional_dirs
		# /etc komplett (wenige MB Text); was davon nicht eingespielt wird, entscheidet der Restore
		printf 'etc\n'
	} | awk 'NF && !seen[$0]++' | while IFS= read -r e; do
		if [ -e "$(lbb_p "/$e")" ] || [ -L "$(lbb_p "/$e")" ]; then
			printf '%s\n' "$e"
		fi
	done > "$work/payload.list"
	# Für einen Restore auf anderer Architektur (apply lässt diese Pfade dann weg)
	collect_native "$work/payload.list" > "$work/meta/native.txt"

	{
		printf '%s\n' "$rel/log/system_tmpfs" "$rel/.cache" "$rel/.npm/_cacache" "$rel/data/system/tmp"
		# MariaDB-Dateien nie direkt: kommen als Dump (dumps/mariadb.sql)
		printf '%s\n' var/lib/mysql
		# Eindeutige ID der Box: ein Clone bekommt eine eigene (apply, R10)
		printf '%s\n' "$rel/config/system/loxberryid.cfg"
		if [ "$LBB_NO_LOGS" = 1 ]; then
			printf '%s\n' "$rel/log"
		fi
		for e in "${LBB_PLUGIN_EXCLUDES[@]}"; do
			folder="${e%%:*}"
			path="${e#*:}"
			printf '%s\n' "$rel/data/plugins/$folder/$path"
		done
		# Liegt das Ausgabeverzeichnis in der Payload, würde das Backup sich und seine Vorgänger mitsichern
		out_abs="$(readlink -m "$LBB_OUTPUT")"
		root_abs="$(readlink -m "$(lbb_p /)")"
		case "$out_abs" in
			"$root_abs"/*) printf '%s\n' "${out_abs#"$root_abs"/}" ;;
		esac
	} > "$work/exclude.list"
}

create_main() {
	local lbhome work out rc s ext logdir avail
	lbb_require_root
	lbhome="$(lbb_lbhomedir)"
	[ -n "$lbhome" ] || die 2 "Kein LoxBerry gefunden (LBHOMEDIR fehlt in /etc/environment)."
	if [ -z "$LBB_LOGFILE" ]; then
		logdir="$(lbb_p "$lbhome")/log/system/lbclone"
		mkdir -p "$logdir"
		LBB_LOGFILE="$logdir/create-$(date +%Y%m%d-%H%M%S).log"
	fi
	[ -n "${LBB_OUTPUT:-}" ] || die 2 "--output fehlt."
	case "$(readlink -m "$LBB_OUTPUT")/" in
		/tmp/*) [ "${LBB_ALLOW_TMP_OUTPUT:-0}" = 1 ] || die 2 "--output darf nicht unter /tmp liegen (tmpfs)." ;;
	esac
	[ -d "$LBB_OUTPUT" ] && [ -w "$LBB_OUTPUT" ] || die 2 "Ausgabeverzeichnis nicht beschreibbar: $LBB_OUTPUT"

	# jq, 7-Zip und ggf. gpg bei Bedarf nachinstallieren
	case "$LBB_COMPRESS" in
		7z|zip|gz) ;;
		*) die 2 "--compress: '$LBB_COMPRESS' – erlaubt sind 7z, zip und gz." ;;
	esac
	local -a tools=(jq:jq "$(archive_tools "$LBB_COMPRESS")")
	if [ "$LBB_PASSFILE" != "-" ]; then
		tools+=(gpg:gpg)
	fi
	lbb_ensure_tools "${tools[@]}"

	meta_collect_system "$lbhome"
	meta_check_v0 || die 2 "Nicht unterstützt: Debian $META_OS_VERSION_ID / LoxBerry $META_LB_VERSION (mindestens Debian 13 und LoxBerry 4)."

	work="$(mktemp -d /tmp/lbclone.XXXXXX)"
	_LBB_WORK="$work"
	trap '_create_restart_services; rm -rf "$_LBB_WORK" ${_LBB_STAGE:+"$_LBB_STAGE"}; [ -z "$_LBB_OUT" ] || rm -f "$_LBB_OUT"' EXIT
	trap 'exit 3' INT TERM

	create_build_meta "$work" "$lbhome"
	if [ ! -r "$(lbb_p "$lbhome")/packages${META_OS_VERSION_ID%%.*}.txt" ]; then
		log_warn "packages${META_OS_VERSION_ID%%.*}.txt fehlt – ohne Installer-Liste werden keine Paketdatenverzeichnisse unter /var/lib gesichert."
	fi
	create_build_lists "$work" "$lbhome"
	META_PAYLOAD_BYTES="$(cd "$(lbb_p /)" && tr '\n' '\0' < "$work/payload.list" \
		| du -sbc --files0-from=- --exclude-from="$work/exclude.list" 2>/dev/null | tail -n 1 | cut -f1)"
	meta_write_json "$work/meta/meta.json" "$(lbb_p "$lbhome")/data/system/plugindatabase.json-"
	meta_write_sums "$work"

	log_info "Von Hand installierte Pakete: $(wc -l < "$work/meta/apt/manual.txt")"
	log_info "Zu sichernde Pfade: $(wc -l < "$work/payload.list") Pfade, ca. $(( ${META_PAYLOAD_BYTES:-0} / 1048576 )) MB"
	avail="$(df --output=avail -B1 "$LBB_OUTPUT" 2>/dev/null | tail -n 1 | tr -d ' ')"
	if [[ "$avail" =~ ^[0-9]+$ ]] && [ "$avail" -lt "${META_PAYLOAD_BYTES:-0}" ]; then
		log_warn "Wenig Platz am Ziel: $((avail / 1048576)) MB frei, Payload unkomprimiert ca. $(( ${META_PAYLOAD_BYTES:-0} / 1048576 )) MB."
	fi
	if [ "${LBB_DRY_RUN:-0}" = 1 ]; then
		sed 's/^/  /' "$work/payload.list"
		return 0
	fi

	tar -C "$work" -cf "$work/meta.tar" meta || die 3 "meta.tar ließ sich nicht erzeugen."

	# Mosquitto nicht stoppen: per SIGUSR1 schreiben lassen, dann die fertige Datei kopieren (SPEC 7.3)
	if [ -d "$(lbb_p /var/lib/mosquitto)" ]; then
		_create_flush_mosquitto
		mkdir -p "$work/snap/var/lib"
		cp -a "$(lbb_p /var/lib/mosquitto)" "$work/snap/var/lib/"
		# Nur das Verzeichnis selbst ins Archiv, nicht var/ und var/lib/ (deren Rechte kämen sonst mit)
		printf 'var/lib/mosquitto\n' > "$work/snap.list"
	fi
	_LBB_STAGE="$(mktemp -d "$LBB_OUTPUT/.lbclone-stage.XXXXXX")"
	_create_dump_mariadb "$_LBB_STAGE"
	for s in "${LBB_STOP_SERVICES[@]}"; do
		_create_stop_service "$s"
	done

	ext="$(archive_ext "$LBB_COMPRESS")"
	out="$LBB_OUTPUT/lbclone-${META_HOSTNAME}-${META_LB_VERSION}-$(date +%Y%m%d-%H%M%S).$ext"
	log_info "Schreibe $out"
	_LBB_OUT="$out"
	archive_create "$out" "$work" "$LBB_COMPRESS" "$LBB_PASSFILE" "$work/exclude.list" "$work/payload.list" "$_LBB_STAGE"
	rc=$?
	_create_restart_services
	rm -rf "$_LBB_STAGE"
	_LBB_STAGE=""
	case "$rc" in
		0) ;;
		1) log_warn "Dateien haben sich während des Backups geändert." ;;
		*) rm -f "$out"; die 3 "Archiv konnte nicht geschrieben werden." ;;
	esac
	if [ -s "$work/tar-warnings.txt" ]; then
		log_warn "tar meldete $(wc -l < "$work/tar-warnings.txt") Problem(e), z. B. nicht lesbare Dateien:"
		head -n 20 "$work/tar-warnings.txt" | while IFS= read -r s; do log_warn "  $s"; done
	fi
	chmod 600 "$out"
	archive_verify "$out" "$LBB_PASSFILE" "$work/verify" || die 3 "Prüfung des Archivs fehlgeschlagen: $out"
	_LBB_OUT=""
	log_ok "Backup fertig: $out ($(du -h "$out" | cut -f1))"
	log_info "Einspielen auf einem frischen DietPi: Archiv entpacken (7z x …, auch unter Windows möglich), im entpackten Ordner als root: bash lbclone apply"
	case "$LBB_OUTPUT" in
		/mnt/*|/media/*)
			if [ "$LBB_PASSFILE" = "-" ]; then
				log_warn "Backup liegt auf einem Netz- oder Wechsellaufwerk und ist unverschlüsselt; es enthält Zugangsdaten. Empfehlung: --encrypt."
			fi
			;;
	esac
}

# Gemeinsame Vorbereitung für info und verify: Werkzeuge und Arbeitsordner (setzt _LBB_WORK)
_readonly_prepare() {
	lbb_ensure_tools jq:jq "$(archive_tools "$LBB_INPUT")"
	if archive_is_encrypted "$LBB_INPUT"; then
		archive_require_pass "$LBB_INPUT" "$LBB_PASSFILE"
		lbb_ensure_tools gpg:gpg
	fi
	_LBB_WORK="$(mktemp -d "/tmp/lbclone-$1.XXXXXX")"
	trap 'rm -rf "$_LBB_WORK"' EXIT
}

info_main() {
	[ -r "$LBB_INPUT" ] || die 2 "Backup nicht lesbar: $LBB_INPUT"
	_readonly_prepare info
	archive_read_meta "$LBB_INPUT" "$LBB_PASSFILE" "$_LBB_WORK" || die 3 "Manifest nicht lesbar."
	meta_read_json "$_LBB_WORK/meta/meta.json"
	printf 'Box:         %s\n' "$META_HOSTNAME"
	printf 'System:      %s %s (%s), %s\n' "$META_OS_ID" "$META_OS_VERSION_ID" "$META_OS_CODENAME" "$META_ARCH"
	printf 'LoxBerry:    %s in %s\n' "$META_LB_VERSION" "$META_LB_HOMEDIR"
	printf 'Payload:     ca. %s MB\n' "$(( ${META_PAYLOAD_BYTES:-0} / 1048576 ))"
	printf 'Installer:   %s -t %s\n' "$(installer_script_name "$META_OS_CODENAME" "$META_LB_VERSION")" "$META_LB_VERSION"
	printf 'Plugins:\n'
	plugins_decide --meta "$_LBB_WORK/meta/meta.json" | awk -F'\t' '{printf "  %-24s %-12s autoupdate=%s  %s %s\n", $2, $4, $5, $6, $7}'
}

verify_main() {
	[ -r "$LBB_INPUT" ] || die 2 "Backup nicht lesbar: $LBB_INPUT"
	_readonly_prepare verify
	archive_verify "$LBB_INPUT" "$LBB_PASSFILE" "$_LBB_WORK" || die 3 "Archiv beschädigt oder Prüfsummen falsch: $LBB_INPUT"
	log_ok "Archiv in Ordnung: $LBB_INPUT"
}

# ============================================================ apply

# Ablauf "lbclone apply" (SPEC 3, 6).

: "${LBB_STATE_DIR:=/var/lib/lbclone}"

_apply_state() {
	lbb_p "$LBB_STATE_DIR"
}

_apply_os_release() {
	sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$(lbb_p /etc/os-release)" 2>/dev/null | head -n 1
}

apply_precheck() {
	local st lbhome have_ver avail path
	lbb_require_root
	if [ -n "${LBB_NEW_HOSTNAME:-}" ] && ! [[ "$LBB_NEW_HOSTNAME" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then
		die 2 "--hostname: '$LBB_NEW_HOSTNAME' ist kein gültiger Hostname (Buchstaben, Ziffern, Bindestrich, max. 63 Zeichen)."
	fi
	[ -r "$LBB_INPUT" ] || die 2 "Clone nicht lesbar: $LBB_INPUT"
	# Für ein --resume nach einem Abbruch muss das Werkzeug Installer und Neustart überleben
	path="${LBB_SELF_CHECK_PATH:-$LBB_SELF}"
	case "$path" in
		/opt/*|/tmp/*) die 2 "lbclone liegt unter $path – der Installer löscht LBHOMEDIR, der Neustart leert /tmp. Den Clone z. B. nach /root entpacken." ;;
	esac
	# jq für das Manifest, 7-Zip bzw. gzip für das Archiv, gpg bei Verschlüsselung
	lbb_ensure_tools jq:jq "$(archive_tools "$LBB_INPUT")"
	if archive_is_encrypted "$LBB_INPUT"; then
		archive_require_pass "$LBB_INPUT" "$LBB_PASSFILE"
		lbb_ensure_tools gpg:gpg
	fi
	st="$(_apply_state)"
	rm -rf "$st/meta"
	mkdir -p "$st"
	chmod 700 "$st"
	log_debug "Clone: $LBB_INPUT"
	archive_read_meta "$LBB_INPUT" "$LBB_PASSFILE" "$st" || die 2 "Manifest nicht lesbar (Passphrase?)."
	meta_check_sums "$st" || die 2 "Prüfsummen des Manifests stimmen nicht."
	meta_read_json "$st/meta/meta.json"
	log_debug "Manifest: $META_HOSTNAME, $META_OS_ID $META_OS_VERSION_ID ($META_OS_CODENAME), $META_ARCH, LoxBerry $META_LB_VERSION"

	meta_check_v0 || die 2 "Backup von Debian $META_OS_VERSION_ID / LoxBerry $META_LB_VERSION wird nicht unterstützt."
	if [ "$(_apply_os_release ID)" != "$META_OS_ID" ] ||
		[ "$(_apply_os_release VERSION_ID)" != "$META_OS_VERSION_ID" ] ||
		[ "$(_apply_os_release VERSION_CODENAME)" != "$META_OS_CODENAME" ]; then
		die 2 "Betriebssystem passt nicht (Backup: $META_OS_ID $META_OS_VERSION_ID $META_OS_CODENAME)."
	fi
	if [ -n "${META_DEBIAN_VERSION:-}" ] && [ "$(cat "$(lbb_p /etc/debian_version)" 2>/dev/null)" != "$META_DEBIAN_VERSION" ]; then
		log_warn "Debian-Subversion weicht ab (Backup $META_DEBIAN_VERSION, hier $(cat "$(lbb_p /etc/debian_version)" 2>/dev/null))."
	fi
	LBB_ARCH_CHANGE=0
	if [ "$(dpkg --print-architecture)" != "$META_ARCH" ]; then
		[ -e "$st/meta/native.txt" ] ||
			die 2 "Architekturwechsel ($META_ARCH → $(dpkg --print-architecture)): Dieser Clone enthält keine Liste der architekturgebundenen Dateien. Den Clone mit dem aktuellen lbclone neu erstellen."
		LBB_ARCH_CHANGE=1
		_apply_arch_warning "$META_ARCH" "$(dpkg --print-architecture)"
	fi
	[ -e "$(lbb_p /boot/dietpi/.version)" ] || die 2 "Kein DietPi gefunden."

	if [ "${LBB_ALLOW_CORE_MISMATCH:-0}" = 1 ] && [ "${LBB_SKIP_INSTALL:-0}" != 1 ]; then
		die 2 "--allow-core-mismatch gilt nur zusammen mit --skip-install."
	fi
	lbhome="$(lbb_lbhomedir)"
	if [ "${LBB_SKIP_INSTALL:-0}" != 1 ]; then
		# Sperrdatei, die der Installer nach erfolgreicher Installation anlegt (install_trixie_v4.sh:28).
		# Der Pfad ist ein Fakt über den Installer; zweiteilig, damit die Pfadprüfung nicht anschlägt.
		if [ -n "$lbhome" ] || [ -e "$(lbb_p "/opt/lox""berry/config/system/do_lbupdate")" ]; then
			die 2 "Es ist bereits ein LoxBerry installiert. Restore braucht ein frisches DietPi (oder --skip-install)."
		fi
	else
		[ -n "$lbhome" ] || die 2 "--skip-install, aber kein LoxBerry installiert."
		[ "$lbhome" = "$META_LB_HOMEDIR" ] || die 2 "LBHOMEDIR $lbhome weicht vom Backup ab ($META_LB_HOMEDIR)."
		have_ver="$(jq -r '.Base.Version // empty' "$(lbb_p "$lbhome")/config/system/general.json" 2>/dev/null)"
		if [ "$have_ver" != "$META_LB_VERSION" ] && [ "${LBB_ALLOW_CORE_MISMATCH:-0}" != 1 ]; then
			die 2 "Installiert ist LoxBerry $have_ver, das Backup stammt von $META_LB_VERSION."
		fi
	fi

	avail="$(df --output=avail -B1 "$(lbb_p /)" | tail -n 1 | tr -d ' ')"
	[ "$avail" -gt "$(( ${META_PAYLOAD_BYTES:-0} * 2 ))" ] || die 2 "Zu wenig Platz ($avail Bytes frei, Backup ca. $META_PAYLOAD_BYTES)."


	# Clone einmal unverschlüsselt ins Zustandsverzeichnis (Platte): danach braucht der Restore
	# weder 7-Zip noch die Passphrase, und es ist egal, wo das Archiv lag
	if [ "${LBB_DRY_RUN:-0}" != 1 ]; then
		case "$(readlink -m "$LBB_INPUT")" in
			/opt/*|/tmp/*) path=volatil ;;
			*) path=dauerhaft ;;
		esac
		if archive_is_encrypted "$LBB_INPUT" || [ "$(archive_tools "$LBB_INPUT")" != tar:tar ] || [ "$path" = volatil ]; then
			log_info "Lege $LBB_INNER nach $st"
			( umask 077; archive_stream "$LBB_INPUT" "$LBB_PASSFILE" > "$st/$LBB_INNER" ) || die 2 "Clone ließ sich nicht auspacken (Passphrase?)."
			LBB_INPUT="$st/$LBB_INNER"
			LBB_PASSFILE="-"
		fi
	fi

	LBB_INSTALLER_SCRIPT="$(installer_script_name "$META_OS_CODENAME" "$META_LB_VERSION")"
	if [ "${LBB_SKIP_INSTALL:-0}" != 1 ]; then
		installer_available "$LBB_INSTALLER_SCRIPT" || die 2 "Installer-Skript $LBB_INSTALLER_SCRIPT nicht gefunden ($(installer_url "$LBB_INSTALLER_SCRIPT"))."
		installer_release_exists "$META_LB_VERSION" || die 2 "LoxBerry-Release $META_LB_VERSION auf GitHub nicht gefunden."
	fi
	log_ok "Vorprüfung bestanden: $META_HOSTNAME, LoxBerry $META_LB_VERSION, Installer $LBB_INSTALLER_SCRIPT"
}

LBB_APPLY_STEPS="R2 R4 R5 R6 R7 R8 R9 R10 R11 R11B R11C R12 R13"

_state_file() {
	printf '%s/apply.state' "$(_apply_state)"
}

# Zustand als Zeilen "SCHLÜSSEL<TAB>wert"
state_set() {
	local f
	f="$(_state_file)"
	(
		umask 077
		mkdir -p "$(dirname "$f")"
		chmod 700 "$(dirname "$f")"
		touch "$f"
		grep -v "^$1"$'\t' "$f" > "$f.new" || true
		printf '%s\t%s\n' "$1" "$2" >> "$f.new"
		mv "$f.new" "$f"
	)
}

state_get() {
	local f
	f="$(_state_file)"
	[ -r "$f" ] || return 0
	grep "^$1"$'\t' "$f" | tail -n 1 | cut -f2-
}

state_done() {
	state_set "DONE_$1" 1
}

state_is_done() {
	[ "$(state_get "DONE_$1")" = 1 ]
}

_apply_step_skipped() {
	case "$1" in
		R2) [ "$(state_get SKIP_INSTALL)" = 1 ] ;;
		R11C) [ "$(state_get UPDATE_CORE)" != 1 ] ;;
		*) return 1 ;;
	esac
}

# Was ein Schritt tut, in Worten für den Anwender (die Kürzel bleiben intern im Zustand)
_apply_step_title() {
	case "$1" in
		R2)   printf 'LoxBerry mit dem Installer installieren (dauert lange, auf einem Raspberry bis zu einer Stunde)' ;;
		R4)   printf 'LoxBerry-Dienste anhalten (loxberry, apache2, mosquitto, cron)' ;;
		R5)   printf 'Paketquellen aus dem Clone übernehmen und Paketlisten aktualisieren' ;;
		R6)   printf 'Fehlende DietPi-Software nachinstallieren' ;;
		R7)   printf 'Pakete der Quellbox installieren (je nach Umfang länger)' ;;
		R8)   printf 'Benutzer, Gruppen und Passwörter übernehmen' ;;
		R9)   printf 'Dateien aus dem Clone zurückspielen (/etc, LoxBerry mit Plugins und Daten, /usr/local, /var)' ;;
		R10)  printf 'System anpassen: Hostname, neue LoxBerry-ID, Zeitzone, MQTT-Passwörter, Dateirechte' ;;
		R11)  printf 'Dienste wieder starten' ;;
		R11B) printf 'MariaDB-Datenbanken einspielen' ;;
		R11C) printf 'LoxBerry auf das neueste Release aktualisieren' ;;
		R12)  printf 'Plugins neu installieren' ;;
		R13)  printf 'Abschluss: Bericht ausgeben, Log ablegen, aufräumen' ;;
		*)    printf '%s' "$1" ;;
	esac
}

# Arbeitsverzeichnis der Schritte: das Home von loxberry. Programme, die per "sudo -u loxberry"
# laufen (z. B. find in plugininstall.pl:1806), scheitern in einem Verzeichnis, das loxberry nicht
# betreten darf (/root). Vor und während der Installation gibt es das Home noch nicht bzw. der
# Installer löscht es (install_trixie_v4.sh:245) – dann /.
_apply_workdir() {
	local home
	home="$(getent passwd loxberry 2>/dev/null | cut -d: -f6)"
	if [ -n "$home" ] && [ -d "$(lbb_p "$home")" ]; then
		lbb_p "$home"
	else
		lbb_p /
	fi
}

apply_run_steps() {
	local s n=0 total=0
	for s in $LBB_APPLY_STEPS; do
		_apply_step_skipped "$s" || total=$((total + 1))
	done
	for s in $LBB_APPLY_STEPS; do
		_apply_step_skipped "$s" || n=$((n + 1))
		state_is_done "$s" && continue
		if _apply_step_skipped "$s"; then
			state_done "$s"
			continue
		fi
		log_info "Schritt $n von $total: $(_apply_step_title "$s")"
		cd "$(_apply_workdir)" || cd / || return 3
		if ! "apply_step_$s"; then
			log_err "Fehlgeschlagen: $(_apply_step_title "$s"). Details im Log ${LBB_LOGFILE:-}; nach der Behebung fortsetzen mit: bash lbclone apply --resume"
			return 3
		fi
		state_done "$s"
	done
	return 0
}

# Deutlicher Hinweis auf den Architekturwechsel, auf dem Schirm und im Log
_apply_arch_warning() {
	local line
	while IFS= read -r line; do
		_lbb_log WARNING "$line"
	done <<EOF
################################################################################
ARCHITEKTURWECHSEL: Der Clone stammt von $1, dieses System ist $2.
Das ist ein Risiko. Programme und Bibliotheken aus dem Clone passen nicht zu
dieser Architektur. lbclone spielt sie deshalb nicht ein, sondern verlässt sich
auf den Installer und auf die Neuinstallation der Plugins:
  - LoxBerry, Node.js und die Python-Umgebungen des Cores kommen vom Installer.
  - Alle Plugins mit Download-Adresse werden neu installiert, unabhängig von
    ihrer Autoupdate-Einstellung.
  - Plugins ohne Download-Adresse oder ohne Unterstützung für $2 bleiben
    ohne ihre Programmteile und funktionieren dann vermutlich nicht.
  - Eigene Programme unter /usr/local und Daten, deren Format von der
    Architektur abhängt, müssen von Hand geprüft werden.
Nach dem Einspielen alle Plugins und Funktionen sorgfältig prüfen.
################################################################################
EOF
	log_warn "Architekturwechsel $1 → $2: Risiko, siehe Hinweis oben. Alle Plugins und Funktionen prüfen."
}

_apply_save_options() {
	state_set INPUT "$(readlink -m "$LBB_INPUT")"
	state_set VERBOSE "${LBB_VERBOSE:-0}"
	state_set SKIP_INSTALL "${LBB_SKIP_INSTALL:-0}"
	state_set ALLOW_CORE_MISMATCH "${LBB_ALLOW_CORE_MISMATCH:-0}"
	state_set FORCE_PLUGIN_REINSTALL "${LBB_FORCE_PLUGIN_REINSTALL:-0}"
	state_set NO_PLUGIN_REINSTALL "${LBB_NO_PLUGIN_REINSTALL:-0}"
	state_set SKIP_PLUGINS "${LBB_SKIP_PLUGINS[*]}"
	state_set GITHUB_AUTH "${LBB_GITHUB_AUTH:-}"
	state_set NO_REBOOT "${LBB_NO_REBOOT:-0}"
	state_set INSTALLER_SCRIPT "$LBB_INSTALLER_SCRIPT"
	state_set NEW_HOSTNAME "${LBB_NEW_HOSTNAME:-}"
	state_set NEW_LBNAME "${LBB_NEW_LBNAME:-}"
	state_set UPDATE_CORE "${LBB_UPDATE_CORE:-0}"
	state_set ARCH_CHANGE "${LBB_ARCH_CHANGE:-0}"
}

_apply_load_options() {
	LBB_INPUT="$(state_get INPUT)"
	LBB_VERBOSE="$(state_get VERBOSE)"
	LBB_SKIP_INSTALL="$(state_get SKIP_INSTALL)"
	LBB_ALLOW_CORE_MISMATCH="$(state_get ALLOW_CORE_MISMATCH)"
	LBB_FORCE_PLUGIN_REINSTALL="$(state_get FORCE_PLUGIN_REINSTALL)"
	LBB_NO_PLUGIN_REINSTALL="$(state_get NO_PLUGIN_REINSTALL)"
	read -r -a LBB_SKIP_PLUGINS <<< "$(state_get SKIP_PLUGINS)"
	LBB_GITHUB_AUTH="$(state_get GITHUB_AUTH)"
	LBB_NO_REBOOT="$(state_get NO_REBOOT)"
	LBB_INSTALLER_SCRIPT="$(state_get INSTALLER_SCRIPT)"
	meta_read_json "$(_apply_state)/meta/meta.json"
}

_apply_console() {
	printf '%s/console.log' "$(_apply_state)"
}

# Ausgabe des Hintergrundprozesses anzeigen, bis er endet: _apply_follow <pid> <tail-zeilen> [eigenes-kind]
# Strg+C beendet nur die Anzeige. Beim eigenen Kind kommt dessen Exitcode zurück.
_apply_follow() {
	local pid="$1" lines="$2" own="${3:-0}" tailpid rc=0
	tail -n "$lines" -F --pid="$pid" "$(_apply_console)" 2>/dev/null &
	tailpid=$!
	trap 'kill "$tailpid" 2>/dev/null; printf "\n"; log_info "Anzeige beendet – der Restore läuft im Hintergrund weiter. Fortschritt wieder anzeigen: bash lbclone apply"; exit 0' INT
	if [ "$own" = 1 ]; then
		wait "$pid"
		rc=$?
	fi
	wait "$tailpid"
	trap - INT
	return "$rc"
}

# Restore vom Terminal lösen: eigener Prozess in eigener Session (kein SIGHUP beim Abriss der
# SSH-Verbindung), Ausgabe in console.log, die hier mitgelesen wird
_apply_detach() {
	local console pid
	console="$(_apply_console)"
	( umask 077; : > "$console" )
	# Sperre an den Hintergrundprozess abgeben
	exec 9>&-
	LBB_DETACHED=1 setsid -w bash "$LBB_SELF" apply --resume < /dev/null >> "$console" 2>&1 &
	pid=$!
	log_info "Der Restore läuft im Hintergrund und läuft weiter, auch wenn die Verbindung abreißt. Fortschritt wieder anzeigen: nach dem Einloggen erneut 'bash lbclone apply'. Strg+C beendet nur die Anzeige."
	_apply_follow "$pid" +1 1
}

apply_main() {
	local rc pid
	lbb_require_root
	mkdir -p "$(lbb_p /var/log/lbclone)" "$(_apply_state)"
	chmod 700 "$(_apply_state)"
	LBB_LOGFILE="${LBB_LOGFILE:-$(lbb_p /var/log/lbclone)/apply.log}"
	LBB_WARNFILE="$(_apply_state)/warnings.txt"
	# Nur ein Restore gleichzeitig
	exec 9> "$(_apply_state)/apply.lock"
	if ! flock -n 9; then
		pid="$(cat "$(_apply_state)/apply.pid" 2>/dev/null)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			log_info "Ein Restore läuft bereits – zeige seinen Fortschritt. Strg+C beendet nur die Anzeige."
			_apply_follow "$pid" 30
			return 0
		fi
		die 2 "Ein Restore läuft bereits (Log: $LBB_LOGFILE)."
	fi
	if [ "${LBB_RESUME:-0}" = 1 ]; then
		[ -r "$(_state_file)" ] || die 2 "Kein Restore-Zustand gefunden."
		if [ "${LBB_DETACHED:-0}" != 1 ]; then
			_apply_detach
			rc=$?
			[ "$rc" = 0 ] || exit "$rc"
			return 0
		fi
		trap '' HUP
		echo "$$" > "$(_apply_state)/apply.pid"
		_apply_load_options
		apply_run_steps
		rc=$?
		[ "$rc" = 0 ] || exit "$rc"
		return 0
	fi
	if [ -r "$(_state_file)" ]; then
		die 2 "Es gibt bereits einen Restore-Zustand ($(_state_file)). Fortsetzen mit 'lbclone apply --resume' oder Datei nach Prüfung entfernen."
	fi
	[ -n "${LBB_INPUT:-}" ] || die 2 "--input fehlt."
	# Bricht die Vorprüfung ab, keine Meta-Daten (u. a. Passwort-Hashes) liegen lassen
	trap '[ -e "$(_state_file)" ] || rm -rf "$(_apply_state)/meta" "$(_apply_state)/$LBB_INNER"' EXIT
	apply_precheck
	if [ "${LBB_DRY_RUN:-0}" = 1 ]; then
		printf 'Installer: %s -t %s\n' "$LBB_INSTALLER_SCRIPT" "$META_LB_VERSION"
		# Vor der Installation fehlen die LoxBerry-Perl-Libs; dann nur Hinweis
		plugins_decide --meta "$(_apply_state)/meta/meta.json" 2>/dev/null ||
			log_warn "Plugin-Plan erst nach der Installation verfügbar; 'lbclone info' auf einem LoxBerry zeigt ihn vorab."
		rm -rf "$(_apply_state)/meta" "$(_apply_state)/$LBB_INNER"
		return 0
	fi
	_apply_save_options
	_apply_detach
	rc=$?
	[ "$rc" = 0 ] || exit "$rc"
	return 0
}

apply_step_R2() {
	local rc
	LBB_GITHUB_AUTH="$(state_get GITHUB_AUTH)"
	log_info "Installiere LoxBerry $META_LB_VERSION mit $LBB_INSTALLER_SCRIPT (Commit $(installer_commit "$LBB_INSTALLER_SCRIPT"))"
	installer_run "$LBB_INSTALLER_SCRIPT" "$META_LB_VERSION" "$(_apply_state)/installer" 2>&1 | lbb_output_always
	rc="${PIPESTATUS[0]}"
	if [ "$rc" != 0 ]; then
		log_err "Installer endete mit Exitcode $rc (Log: $LBB_LOGFILE)."
		return 1
	fi
	installer_verify "$META_LB_VERSION" "$META_LB_HOMEDIR" || return 1
	# Der Installer legt do_lbupdate an (install_trixie_v4.sh:978); beim nächsten Boot würde
	# 03-loxberryupdate dann aufs neueste Release aktualisieren – vor dem Einspielen des Clones.
	rm -f "$(lbb_p "$META_LB_HOMEDIR")/config/system/do_lbupdate"
	log_ok "LoxBerry $META_LB_VERSION installiert (automatisches Core-Update beim ersten Boot unterbunden)."
}

: "${LBB_DIETPI_SOFTWARE:=/boot/dietpi/dietpi-software}"

_apply_meta() {
	printf '%s/meta' "$(_apply_state)"
}

# Liest /etc/environment in die Umgebung (LoxBerry-Skripte brauchen LBHOMEDIR, PERL5LIB …)
apply_env_load() {
	local env
	env="$(lbb_p /etc/environment)"
	[ -r "$env" ] || return 0
	set -a
	# shellcheck disable=SC1090
	. "$env"
	set +a
}

# Mitgesicherte Schlüssel der Paketquellen einzeln zurück (cp -a <dir>/. würde Rechte von /, /etc … überschreiben)
_apply_restore_keyrings() {
	local k f
	k="$(_apply_meta)/apt/keyrings"
	[ -d "$k" ] || return 0
	( cd "$k" && find . -type f ) | while IFS= read -r f; do
		f="${f#./}"
		mkdir -p "$(dirname "$(lbb_p "/$f")")"
		cp -a "$k/$f" "$(lbb_p "/$f")"
	done
}

apply_step_R4() {
	systemctl stop loxberry apache2 mosquitto cron || log_warn "Nicht alle Dienste ließen sich stoppen."
	return 0
}

apply_step_R5() {
	local m f
	m="$(_apply_meta)/apt"
	mkdir -p "$(lbb_p /etc/apt/sources.list.d)" "$(lbb_p /etc/apt/preferences.d)" "$(lbb_p /etc/apt/trusted.gpg.d)"
	cp -a "$m/sources.list.d/." "$(lbb_p /etc/apt/sources.list.d)/"
	_apply_restore_keyrings
	cp -a "$m/preferences.d/." "$(lbb_p /etc/apt/preferences.d)/"
	cp -a "$m/trusted.gpg.d/." "$(lbb_p /etc/apt/trusted.gpg.d)/"
	apt-get update 2>&1 | lbb_output_always
	[ "${PIPESTATUS[0]}" = 0 ] || return 1
}

# Laufende Dienste (für den Vergleich vor/nach der Paketinstallation)
_apply_active_services() {
	systemctl list-units --type=service --state=active --no-legend --plain 2>/dev/null | awk '{print $1}' | sort -u
}

apply_step_R6() {
	local have want
	local -a missing=()
	# Vor DietPi-Software und Paketen festhalten, was schon läuft; R9 stoppt nur, was danach dazukam
	if [ ! -e "$(_apply_state)/services-before.txt" ]; then
		_apply_active_services > "$(_apply_state)/services-before.txt"
	fi
	have="$(collect_dietpi_software)"
	while IFS= read -r want; do
		[ -n "$want" ] || continue
		grep -qx "$want" <<< "$have" || missing+=("$want")
	done < "$(_apply_meta)/dietpi-software.txt"
	[ "${#missing[@]}" -eq 0 ] && return 0
	"$LBB_DIETPI_SOFTWARE" install "${missing[@]}" || log_warn "DietPi-Software ${missing[*]} nicht vollständig installiert."
	return 0
}

apply_step_R7() {
	local m pkg deb
	local -a ok=()
	local avail
	m="$(_apply_meta)/apt"
	log_info "Prüfe, welche der $(grep -c . "$m/manual.txt") Pakete in den Paketquellen verfügbar sind"
	# Ein Aufruf für alle Namen statt apt-cache show je Paket (bei über tausend Paketen minutenlang)
	avail="$(_apply_state)/pkgnames.txt"
	apt-cache pkgnames 2>/dev/null | sort -u > "$avail"
	while IFS= read -r pkg; do
		[ -n "$pkg" ] || continue
		if grep -qxF "${pkg%%:*}" "$avail"; then
			ok+=("$pkg")
		else
			log_warn "Paket $pkg ist in keiner Quelle verfügbar."
		fi
	done < "$m/manual.txt"
	rm -f "$avail"
	if [ "${#ok[@]}" -gt 0 ]; then
		log_info "Installiere ${#ok[@]} Pakete"
		if ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${ok[@]}" 2>&1 | lbb_output_always ||
			[ "${PIPESTATUS[0]}" != 0 ]; then
			log_warn "Gemeinsame Installation fehlgeschlagen, installiere einzeln."
			for pkg in "${ok[@]}"; do
				DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$pkg" 2>&1 | lbb_output_always
				[ "${PIPESTATUS[0]}" = 0 ] || log_warn "Paket $pkg ließ sich nicht installieren."
			done
		fi
	fi
	for deb in "$m/debs"/*.deb; do
		[ -e "$deb" ] || continue
		dpkg -i "$deb" 2>&1 | lbb_output_always
		[ "${PIPESTATUS[0]}" = 0 ] || log_warn "Lokales Paket ${deb##*/} ließ sich nicht installieren."
	done
	DEBIAN_FRONTEND=noninteractive apt-get install -y -f 2>&1 | lbb_output_always
	[ "${PIPESTATUS[0]}" = 0 ] || log_warn "apt-get -f install meldete Fehler."
	while IFS= read -r pkg; do
		if [ -n "$pkg" ]; then
			apt-mark hold "$pkg" || log_warn "Hold für $pkg nicht gesetzt."
		fi
	done < "$m/holds.txt"
	if [ -r "$m/local-packages.txt" ]; then
		awk -F'\t' '$4 == "fehlt" {print $1 " " $2}' "$m/local-packages.txt" | while IFS= read -r pkg; do
			log_warn "Lokales Paket ohne .deb im Backup: $pkg"
		done
	fi
	return 0
}

apply_step_R8() {
	local m name uid home shell groups g hash user
	m="$(_apply_meta)"
	while IFS=: read -r name uid home shell groups; do
		[ -n "$name" ] || continue
		if getent passwd "$name" > /dev/null; then
			continue
		fi
		if getent passwd "$uid" > /dev/null; then
			useradd -m -d "$home" -s "$shell" "$name" || log_warn "Benutzer $name nicht angelegt."
		else
			useradd -m -d "$home" -s "$shell" -u "$uid" "$name" || log_warn "Benutzer $name nicht angelegt."
		fi
		for g in ${groups//,/ }; do
			[ "$g" = "$name" ] && continue
			if getent group "$g" > /dev/null; then
				usermod -a -G "$g" "$name"
			fi
		done
	done < "$m/users.txt"
	while IFS= read -r g; do
		[ -n "$g" ] && [ "$g" != loxberry ] || continue
		if getent group "$g" > /dev/null; then
			usermod -a -G "$g" loxberry || log_warn "loxberry nicht in Gruppe $g aufgenommen."
		else
			log_warn "Gruppe $g existiert nicht; loxberry bleibt ohne sie."
		fi
	done < "$m/groups.txt"
	while IFS=: read -r user hash; do
		if [ -n "$user" ] && [ -n "$hash" ]; then
			usermod -p "$hash" "$user" || log_warn "Passwort für $user nicht gesetzt."
		fi
	done < "$m/passwd-hashes.txt"
	return 0
}

# Dienste, die erst durch DietPi-Software und Pakete (R6/R7) laufen – deren Daten spielt R9 zurück
_apply_new_services() {
	local before
	before="$(_apply_state)/services-before.txt"
	[ -r "$before" ] || return 0
	comm -13 "$before" <(_apply_active_services)
}

apply_step_R9() {
	local input lbrel list
	local -a svcs=()
	input="$(state_get INPUT)"
	mapfile -t svcs < <(_apply_new_services)
	state_set STOPPED_SERVICES "${svcs[*]}"
	if [ "${#svcs[@]}" -gt 0 ]; then
		log_info "Halte neu installierte Dienste an, bevor ihre Daten zurückkommen: ${svcs[*]}"
		systemctl stop "${svcs[@]}" 2>&1 | lbb_output
	fi
	# /etc ohne die Teile, die zur neuen Box gehören (SPEC 5.6); Symlinks nach LBHOMEDIR hat der
	# Installer angelegt, ein Symlink über ein vorhandenes Verzeichnis scheitert sonst
	list="$(_apply_state)/etc-exclude.list"
	{
		lbb_read_patterns <(_lbb_conf_etc_restore_exclude)
		cut -f1 "$(_apply_meta)/etc-symlinks.txt" 2>/dev/null | sed 's|^/||'
	} > "$list"
	lbrel="${META_LB_HOMEDIR#/}"
	# Hardware-Flags (is_raspberry.cfg, is_hwmodel_*.cfg …) hat der Installer für diese Box geschrieben.
	# Datenbank-Dumps ins Zustandsverzeichnis statt nach /dumps.
	local -a common=(--anchored --exclude-from="$list" --exclude="$lbrel/config/system/is_*.cfg"
		--transform="s,^dumps$,${LBB_STATE_DIR#/}/dumps,;s,^dumps/,${LBB_STATE_DIR#/}/dumps/,")
	# Architekturwechsel: architekturgebundene Pfade aus create (meta/native.txt) weglassen
	if [ "$(state_get ARCH_CHANGE)" = 1 ]; then
		common+=(--no-wildcards --exclude-from="$(_apply_meta)/native.txt" --wildcards)
	fi
	if [ "$(state_get ALLOW_CORE_MISMATCH)" = 1 ]; then
		archive_extract "$input" - "$(lbb_p /)" "${common[@]}" --exclude=usr/local --exclude="$lbrel" || return 1
		_apply_extract_userdata_only "$input" "$lbrel" "${common[@]}" || return 1
	else
		archive_extract "$input" - "$(lbb_p /)" "${common[@]}" --exclude=usr/local || return 1
	fi
	# /usr/local: nichts überschreiben, was der Installer schon angelegt hat (z. B. Node.js)
	if ! archive_extract "$input" - "$(lbb_p /)" "${common[@]}" --skip-old-files usr/local 2>&1 | lbb_output; then
		log_warn "Dateien unter /usr/local ließen sich nicht vollständig einspielen (Details im Log)."
	fi
	rm -f "$list"
	log_ok "Dateien zurückgespielt."
}

# Nur die Pfade, die ein Core-Update nicht anfasst (config/system/update-exclude.system)
_apply_extract_userdata_only() {
	local input="$1" lbrel="$2" line re excl listing
	shift 2
	local -a members=()
	excl="$(lbb_p "/$lbrel")/config/system/update-exclude.system"
	if [ ! -r "$excl" ]; then
		log_err "Keine Exclude-Liste des Core-Updates gefunden ($excl) – ohne sie würde der alte Core zurückgespielt."
		return 1
	fi
	listing="$(_apply_state)/archive.list"
	archive_stream "$input" - | tar -t -f - > "$listing" || return 1
	while IFS= read -r line; do
		line="${line%%#*}"
		line="${line%/}"
		case "$line" in
			/*) ;;
			*) continue ;;
		esac
		# Nur Einträge, die im Backup vorkommen – sonst bricht tar mit "Not found in archive" ab
		re="$(printf '%s' "$lbrel$line" | sed -e 's/[].[\^$+(){}|]/\\&/g' -e 's/\*/.*/g' -e 's/?/./g')"
		if grep -qE "^${re}(/|$)" "$listing"; then
			members+=("$lbrel$line")
		fi
	done < "$excl"
	rm -f "$listing"
	if [ "${#members[@]}" -eq 0 ]; then
		log_err "Keine Nutzdaten-Pfade im Backup gefunden – breche ab, statt den alten Core zurückzuspielen."
		return 1
	fi
	log_warn "--allow-core-mismatch: nur Konfiguration und Daten aus dem Backup (ungeprüfter Weg)."
	archive_extract "$input" - "$(lbb_p /)" "$@" --wildcards "${members[@]}"
}

# Neue SSH- und Dropbear-Host-Keys, nur für vorhandene Schlüssel
_apply_new_host_keys() {
	local f t found=0
	for f in "$(lbb_p /etc/ssh)"/ssh_host_*; do
		[ -e "$f" ] || continue
		rm -f "$f"
		found=1
	done
	if [ "$found" = 1 ]; then
		ssh-keygen -A > /dev/null || log_warn "Neue SSH-Host-Keys ließen sich nicht erzeugen."
	fi
	for t in rsa ecdsa ed25519; do
		f="$(lbb_p /etc/dropbear)/dropbear_${t}_host_key"
		[ -e "$f" ] || continue
		rm -f "$f"
		dropbearkey -t "$t" -f "$f" > /dev/null 2>&1 || log_warn "Neuer Dropbear-Host-Key ($t) ließ sich nicht erzeugen."
	done
	log_ok "Neue Host-Keys erzeugt (neuer Hostname)."
}

# LoxBerry-Name (general.json → Network.Friendlyname); Eigentümer und Rechte der Datei bleiben
_apply_set_lbname() {
	local gj tmp
	gj="$(lbb_p "$1")/config/system/general.json"
	tmp="$gj.lbclone"
	if jq --arg n "$2" '.Network.Friendlyname = $n' "$gj" > "$tmp"; then
		cat "$tmp" > "$gj"
		log_ok "LoxBerry-Name gesetzt: $2"
	else
		log_warn "LoxBerry-Name ließ sich nicht setzen."
	fi
	rm -f "$tmp"
}

# Neue loxberryid wie setloxberryid.pl: 128 Zeichen aus A–Z, a–z, 0–9
_apply_new_loxberryid() {
	local f
	f="$(lbb_p "$1")/config/system/loxberryid.cfg"
	[ -e "$f" ] && return 0
	( umask 077; LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 128 > "$f" )
	if [ "$EUID" -eq 0 ]; then
		chown loxberry:loxberry "$f"
	fi
	log_ok "Neue loxberryid angelegt."
}

apply_step_R10() {
	local m lbhome link target tz host lbname
	m="$(_apply_meta)"
	lbhome="$META_LB_HOMEDIR"
	apply_env_load
	while IFS=$'\t' read -r link target; do
		[ -n "$link" ] || continue
		mkdir -p "$(dirname "$(lbb_p "$link")")"
		rm -rf "$(lbb_p "$link")"
		ln -sfn "$target" "$(lbb_p "$link")"
	done < "$m/etc-symlinks.txt"
	# Hostname: aus dem Clone oder neu (--hostname). Neuer Hostname = zweite Box → eigene Host-Keys
	host="$(state_get NEW_HOSTNAME)"
	if [ -n "$host" ] && [ "$host" != "$(cat "$m/hostname")" ]; then
		lbb_logged "$(lbb_p "$lbhome")/sbin/changehostname.sh" "$host" || log_warn "Hostname nicht gesetzt."
		_apply_new_host_keys
	else
		lbb_logged "$(lbb_p "$lbhome")/sbin/changehostname.sh" "$(cat "$m/hostname")" || log_warn "Hostname nicht gesetzt."
	fi
	lbname="$(state_get NEW_LBNAME)"
	if [ -n "$lbname" ]; then
		_apply_set_lbname "$lbhome" "$lbname"
	fi
	if [ "${META_HAS_LOXBERRYID:-0}" = 1 ]; then
		_apply_new_loxberryid "$lbhome"
	fi
	tz="$(cat "$m/timezone" 2>/dev/null)"
	if [ -n "$tz" ]; then
		lbb_logged timedatectl set-timezone "$tz" || log_warn "Zeitzone $tz nicht gesetzt."
	fi
	lbb_logged "$(lbb_p "$lbhome")/sbin/mqtt-handler.pl" action=mosquitto_set || log_warn "Mosquitto-Konfiguration nicht neu erzeugt."
	systemctl daemon-reload 2>&1 | lbb_output
	lbb_logged sysctl --system || log_warn "sysctl --system meldete Fehler."
	lbb_logged "$(lbb_p "$lbhome")/sbin/resetpermissions.sh" || log_warn "Dateirechte: resetpermissions.sh meldete Fehler (Details im Log)."
	return 0
}

apply_step_R11() {
	local -a extra=()
	read -r -a extra <<< "$(state_get STOPPED_SERVICES)"
	systemctl start cron mosquitto apache2 loxberry "${extra[@]}" 2>&1 | lbb_output
	if [ "${PIPESTATUS[0]}" != 0 ]; then
		log_warn "Nicht alle Dienste ließen sich starten (Details im Log ${LBB_LOGFILE:-})."
	fi
	return 0
}

# Datenbank-Dump in die inzwischen installierte und gestartete MariaDB einspielen
apply_step_R11B() {
