apply_step_R12() {
	apply_env_load
	LBB_FORCE_PLUGIN_REINSTALL="$(state_get FORCE_PLUGIN_REINSTALL)"
	LBB_NO_PLUGIN_REINSTALL="$(state_get NO_PLUGIN_REINSTALL)"
	LBB_ARCH_CHANGE="$(state_get ARCH_CHANGE)"
	read -r -a LBB_SKIP_PLUGINS <<< "$(state_get SKIP_PLUGINS)"
	LBB_REPORT="${LBB_REPORT:-$(_apply_state)/report.txt}"
	: > "$LBB_REPORT"
	local work folder status
	work="$(mktemp -d /tmp/lbclone-plugins.XXXXXX)"
	# plugininstall.pl entpackt das Zip als loxberry (sudo -u loxberry unzip, plugininstall.pl:416)
	chmod 755 "$work"
	plugins_reinstall_all "$META_LB_HOMEDIR" "$work" || true
	rm -rf "$work"
	# Architekturwechsel: Plugins, deren Programmteile R9 weggelassen hat und die nicht neu installiert wurden
	if [ "$LBB_ARCH_CHANGE" = 1 ] && [ -r "$(_apply_meta)/native.txt" ]; then
		while IFS=$'\t' read -r folder status _; do
			[ -n "$folder" ] && [ "$status" != OK ] || continue
			if grep -qE "/plugins/${folder}(/|$)" "$(_apply_meta)/native.txt"; then
				log_warn "$folder: enthält Programmteile für eine andere Architektur und wurde nicht neu installiert – funktioniert vermutlich nicht. Über die WebUI neu installieren."
			fi
		done < "$LBB_REPORT"
	fi
	return 0
}

apply_step_R13() {
	local dest
	LBB_REPORT="${LBB_REPORT:-$(_apply_state)/report.txt}"
	local warnfile n final no_reboot
	warnfile="$(_apply_state)/warnings.txt"
	no_reboot="$(state_get NO_REBOOT)"
	{
		printf 'Bericht Plugins:\n'
		if [ -r "$LBB_REPORT" ]; then
			sed 's/\t/   /g; s/^/  /' "$LBB_REPORT"
		fi
		if [ -s "$warnfile" ]; then
			printf 'Warnungen aus allen Phasen:\n'
			sed 's/^/  /' "$warnfile"
		fi
	} | tee -a "${LBB_LOGFILE:-/dev/null}"
	if [ -r "$LBB_REPORT" ] && grep -q $'\tFEHLER\t' "$LBB_REPORT"; then
		log_warn "Plugins mit Fehler: über die WebUI erneut installieren."
	fi
	# Exitcode 1, wenn es in irgendeiner Phase Warnungen gab (auch vor einem --resume)
	if [ -s "$warnfile" ]; then
		n="$(wc -l < "$warnfile")"
		LBB_WARNINGS=$((LBB_WARNINGS + n))
	fi
	dest="$(lbb_p "$META_LB_HOMEDIR")/log/system/lbclone"
	mkdir -p "$dest"
	if [ -n "$LBB_LOGFILE" ] && [ -r "$LBB_LOGFILE" ]; then
		final="$dest/apply-$(date +%Y%m%d-%H%M%S).log"
		mv "$LBB_LOGFILE" "$final"
		LBB_LOGFILE="$final"
	fi
	# Entschlüsselte Kopie des Clones im Zustandsverzeichnis wegräumen
	case "$(state_get INPUT)" in
		"$(_apply_state)"/*) rm -f "$(state_get INPUT)" ;;
	esac
	rm -f "$(_state_file)" "$warnfile"
	rm -rf "$(_apply_state)/meta" "$(_apply_state)/installer"
	log_ok "Restore abgeschlossen."
	if [ "$no_reboot" = 1 ]; then
		log_info "Kein Neustart (--no-reboot); die Box sollte bald neu gestartet werden."
	else
		log_info "Neustart."
		systemctl reboot
	fi
	return 0
}

