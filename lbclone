#!/bin/bash
# lbclone — einen LoxBerry ohne Image klonen.
#   lbclone create  erfasst einen LoxBerry (ohne Betriebssystem) in einem Archiv
#   lbclone apply   spielt ihn auf ein frisches DietPi – als Ersatz oder als zweite Box
# Eine einzige Datei: herunterladen (wget/curl) und mit bash ausführen. Hilfe: lbclone --help
#
# Wird die Datei mit "source" geladen (Tests), definiert sie nur die Funktionen.

LBB_SELF="$(readlink -f "${BASH_SOURCE[0]}")"

# ============================================================ common

# Gemeinsame Helfer für lbclone. Wird von bin/lbclone und den Tests per source geladen.

export LC_ALL=C

LBB_EXIT_OK=0
LBB_EXIT_WARN=1
LBB_EXIT_PRECOND=2
LBB_EXIT_ABORT=3

LBB_WARNINGS=0
: "${LBB_ROOT:=}"
: "${LBB_LOGFILE:=}"

LBB_PLUGIN_EXCLUDES=()
LBB_STOP_SERVICES=()
: "${LBB_NO_LOGS:=0}"
: "${LBB_COMPRESS:=7z}"

# Pfad unter dem (Test-)Root
lbb_p() {
	printf '%s%s' "$LBB_ROOT" "$1"
}

_lbb_log() {
	local tag="$1" line
	shift
	line="$(date '+%Y-%m-%d %H:%M:%S') <$tag> $*"
	printf '%s\n' "$line"
	if [ -n "$LBB_LOGFILE" ]; then
		printf '%s\n' "$line" >> "$LBB_LOGFILE"
	fi
}
log_ok()   { _lbb_log OK "$@"; }
log_info() { _lbb_log INFO "$@"; }
log_warn() {
	LBB_WARNINGS=$((LBB_WARNINGS + 1))
	_lbb_log WARNING "$@"
	# Warnungen über Neustarts hinweg sammeln (Restore)
	if [ -n "${LBB_WARNFILE:-}" ]; then
		printf '%s\n' "$*" >> "$LBB_WARNFILE"
	fi
}
log_err()  { _lbb_log ERROR "$@"; }

# --verbose: gesprächige Ausgabe (Schritte, Befehle, Dateilisten)
: "${LBB_VERBOSE:=0}"
log_debug() {
	if [ "$LBB_VERBOSE" = 1 ]; then
		_lbb_log DEBUG "$@"
	fi
}

# Befehlsausgabe (apt, Installer, plugininstall): ins Log und bei --verbose zusätzlich auf den Schirm
lbb_output() {
	if [ "$LBB_VERBOSE" = 1 ]; then
		tee -a "${LBB_LOGFILE:-/dev/null}"
	else
		cat >> "${LBB_LOGFILE:-/dev/null}"
	fi
}

# Befehl ausführen, Ausgabe ins Log (mit --verbose auch auf den Schirm); Exitcode des Befehls
lbb_logged() {
	"$@" 2>&1 | lbb_output
	return "${PIPESTATUS[0]}"
}

# Wie lbb_output, aber immer auch auf dem Schirm – für lange Läufe (Installer), damit man sieht, dass es weitergeht
lbb_output_always() {
	tee -a "${LBB_LOGFILE:-/dev/null}"
}

# Fehlende Werkzeuge per apt nachinstallieren: lbb_ensure_tools <befehl>:<paket> …
lbb_ensure_tools() {
	local spec cmd pkg
	local -a missing=()
	for spec in "$@"; do
		cmd="${spec%%:*}"
		pkg="${spec#*:}"
		if ! command -v "$cmd" > /dev/null 2>&1; then
			missing+=("$pkg")
		fi
	done
	[ "${#missing[@]}" -eq 0 ] && return 0
	log_info "Installiere fehlende Werkzeuge: ${missing[*]}"
	if ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}" 2>&1 | lbb_output ||
		! _lbb_tools_present "$@"; then
		# Paketlisten evtl. veraltet (frisches DietPi): einmal aktualisieren und erneut versuchen
		apt-get update 2>&1 | lbb_output
		DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}" 2>&1 | lbb_output
	fi
	_lbb_tools_present "$@" || die "$LBB_EXIT_PRECOND" "Werkzeuge fehlen und ließen sich nicht installieren: ${missing[*]}"
	log_ok "Werkzeuge installiert: ${missing[*]}"
}

_lbb_tools_present() {
	local spec
	for spec in "$@"; do
		command -v "${spec%%:*}" > /dev/null 2>&1 || return 1
	done
}

die() {
	local code="$1"
	shift
	_lbb_log FAIL "$@"
	exit "$code"
}

lbb_final_exit() {
	if [ "$LBB_WARNINGS" -gt 0 ]; then
		exit "$LBB_EXIT_WARN"
	fi
	exit "$LBB_EXIT_OK"
}

lbb_require_root() {
	if [ "$EUID" -ne 0 ] && [ "${LBB_ALLOW_NONROOT:-0}" != 1 ]; then
		die "$LBB_EXIT_PRECOND" "lbclone muss als root laufen."
	fi
}

# LBHOMEDIR aus /etc/environment; leer, wenn kein LoxBerry installiert ist
lbb_lbhomedir() {
	local env
	env="$(lbb_p /etc/environment)"
	[ -r "$env" ] || return 0
	sed -n 's/^LBHOMEDIR=//p' "$env" | tail -n 1 | tr -d '"'
}

# Glob-Vergleich für Filterlisten: ** passt über Verzeichnisgrenzen, * und ? nicht.
lbb_glob_match() {
	local pattern="$1" path="$2" re
	re="$(printf '%s' "$pattern" | sed \
		-e 's/[].[\^$+(){}|]/\\&/g' \
		-e 's/\*\*/\x01/g' \
		-e 's/\*/[^\/]*/g' \
		-e 's/?/[^\/]/g' \
		-e 's/\x01/.*/g')"
	[[ "$path" =~ ^${re}$ ]]
}

# Ein Muster pro Zeile; Kommentare (#…) und Leerzeilen fallen weg.
lbb_read_patterns() {
	sed -e 's/#.*$//' "$1" | tr -s ' \t' '\n\n' | sed '/^$/d'
}

lbb_match_any() {
	local path="$1" pat
	shift
	for pat in "$@"; do
		if lbb_glob_match "$pat" "$path"; then
			return 0
		fi
	done
	return 1
}

# Dauerhafte Voreinstellungen: Zeilen "schlüssel = wert"
lbb_load_config() {
	local k v
	[ -r "$1" ] || return 0
	while IFS='=' read -r k v; do
		k="$(printf '%s' "$k" | tr -d ' \t')"
		v="$(printf '%s' "$v" | sed 's/^[ \t]*//;s/[ \t]*$//')"
		case "$k" in
			''|\#*) ;;
			exclude-plugin-data) LBB_PLUGIN_EXCLUDES+=("$v") ;;
			stop-service) LBB_STOP_SERVICES+=("$v") ;;
			no-logs) LBB_NO_LOGS="$v" ;;
			compress) LBB_COMPRESS="$v" ;;
			*) log_warn "Unbekannter Schlüssel in $1: $k" ;;
		esac
	done < "$1"
}

# ============================================================ collect

# Sammelt, was ein LoxBerry gegenüber einer frischen Installation zusätzlich hat.

# Alle manuell installierten Pakete – kein Abgleich mit der Installer-Liste: apt überspringt
# beim Restore selbst, was schon da ist. Nur hardwaregebundene Pakete fallen weg (Ausschlussliste).
collect_manual_packages() {
	local excl="$1" pkg
	local -a pats=()
	mapfile -t pats < <(lbb_read_patterns "$excl")
	apt-mark showmanual | sed 's/:.*$//' | sort -u |
	while IFS= read -r pkg; do
		if ! lbb_match_any "$pkg" "${pats[@]}"; then
			printf '%s\n' "$pkg"
		fi
	done
}

# Pakete ohne Repo-Quelle: name<TAB>version<TAB>arch
collect_local_packages() {
	apt list --installed 2>/dev/null | awk '/\[installed,local\]/ {
		split($1, a, "/")
		print a[1] "\t" $2 "\t" $3
	}'
}

# Sucht ein .deb mit genau diesem Paket, dieser Version und Architektur
find_deb_for() {
	local pkg="$1" ver="$2" arch="$3" dir f
	shift 3
	for dir in "$@"; do
		[ -d "$dir" ] || continue
		while IFS= read -r f; do
			if [ "$(dpkg-deb -f "$f" Package 2>/dev/null)" = "$pkg" ] &&
				[ "$(dpkg-deb -f "$f" Version 2>/dev/null)" = "$ver" ] &&
				[ "$(dpkg-deb -f "$f" Architecture 2>/dev/null)" = "$arch" ]; then
				printf '%s\n' "$f"
				return 0
			fi
		done < <(find "$dir" -type f -name "${pkg}_*.deb" 2>/dev/null | sort)
	done
	return 1
}

collect_holds() {
	apt-mark showhold
}

# Alle Pfade aus der dpkg-Datenbank, die mit <präfix> beginnen
dpkg_owned_paths() {
	cat "$(lbb_p /var/lib/dpkg/info)"/*.list 2>/dev/null | grep -F -- "$1" | grep "^$1" | sort -u
}

# Symlinks in /etc, die nach LBHOMEDIR zeigen: link<TAB>ziel
collect_etc_symlinks() {
	local lbhome="$1" l t
	find "$(lbb_p /etc)" -xdev -type l 2>/dev/null | sort | while IFS= read -r l; do
		t="$(readlink "$l")"
		case "$t" in
			"$lbhome"|"$lbhome"/*) printf '%s\t%s\n' "${l#"$LBB_ROOT"}" "$t" ;;
		esac
	done
}

collect_user_groups() {
	id -nG "$1" | tr ' ' '\n' | sed '/^$/d' | sort
}

# Persönliche Benutzer: name:uid:home:shell:gruppen
collect_extra_users() {
	local name uid home shell
	getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 && $1 != "loxberry" && $1 != "dietpi" {
		print $1 ":" $3 ":" $6 ":" $7
	}' | while IFS=: read -r name uid home shell; do
		printf '%s:%s:%s:%s:%s\n' "$name" "$uid" "$home" "$shell" "$(id -nG "$name" | tr ' ' ',')"
	done
}

collect_passwd_hashes() {
	getent shadow root loxberry | cut -d: -f1,2
}

collect_dietpi_software() {
	local f
	f="$(lbb_p /boot/dietpi/.installed)"
	[ -r "$f" ] || return 0
	sed -n 's/^aSOFTWARE_INSTALL_STATE\[\([0-9]*\)\]=2$/\1/p' "$f" | sort -n
}

# Datenverzeichnisse /var/lib/<paket> nur für Pakete, die nicht in der Installer-Liste
# (packages<VERSION_ID>.txt) stehen – alles andere legt die frische Installation selbst an.
# mosquitto und mysql haben eigene Wege (Snapshot nach SIGUSR1 bzw. Dump).
collect_var_lib_dirs() {
	local manual="$1" ref="$2" pkg
	comm -23 \
		<(sort -u "$manual") \
		<(awk '/^ii /{print $2}' "$ref" | sed 's/:.*$//' | sort -u) |
	while IFS= read -r pkg; do
		case "$pkg" in ''|mosquitto|mysql) continue ;; esac
		if [ -d "$(lbb_p "/var/lib/$pkg")" ]; then
			printf 'var/lib/%s\n' "$pkg"
		fi
	done
}

# Relative Pfade optionaler Bereiche, nur wenn vorhanden und nicht leer bzw. nicht nur Standard
# Architekturgebundene Pfade der Payload (relativ zu /): ELF-Dateien und Python-Umgebungen
# (Verzeichnis mit pyvenv.cfg) als Ganzes. Bei einem Architekturwechsel spielt apply sie nicht ein.
collect_native() {
	( cd "$(lbb_p /)" && tr '\n' '\0' < "$1" | xargs -0 -r perl -MFile::Find -e '
		find({ no_chdir => 1, wanted => sub {
			my $f = $File::Find::name;
			if (-d $f && !-l $f && -e "$f/pyvenv.cfg") { print "$f\n"; $File::Find::prune = 1; return; }
			return if -l $f || !-f $f;
			open(my $h, "<", $f) or return;
			binmode $h;
			my $magic = "";
			read($h, $magic, 4);
			print "$f\n" if $magic eq "\x7fELF";
		} }, @ARGV);' ) | sort
}

collect_optional_dirs() {
	local d
	for d in var/spool/cron/crontabs mnt/dietpi_userdata; do
		if [ -n "$(find "$(lbb_p "/$d")" -mindepth 1 -print -quit 2>/dev/null)" ]; then
			printf '%s\n' "$d"
		fi
	done
	if [ -n "$(find "$(lbb_p /var/www)" -type f ! -path '*/html/index.html' -print -quit 2>/dev/null)" ]; then
		printf 'var/www\n'
	fi
}

# ============================================================ meta

# Manifest eines Clones: meta.json (gelesen mit jq; fehlt jq, installiert lbclone es nach)
# und SHA256SUMS.

_meta_os_release() {
	sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$(lbb_p /etc/os-release)" 2>/dev/null | head -n 1
}

meta_collect_system() {
	META_FORMAT=1
	META_OS_ID="$(_meta_os_release ID)"
	META_OS_VERSION_ID="$(_meta_os_release VERSION_ID)"
	META_OS_CODENAME="$(_meta_os_release VERSION_CODENAME)"
	META_DEBIAN_VERSION="$(cat "$(lbb_p /etc/debian_version)" 2>/dev/null)"
	META_ARCH="$(dpkg --print-architecture)"
	META_LB_HOMEDIR="$1"
	META_LB_VERSION="$(jq -r '.Base.Version // empty' "$(lbb_p "$1")/config/system/general.json" 2>/dev/null)"
	META_HOSTNAME="$(cat "$(lbb_p /etc/hostname)" 2>/dev/null)"
	META_PAYLOAD_BYTES="${META_PAYLOAD_BYTES:-0}"
	# Die loxberryid selbst wird nie geklont; apply legt eine neue an, wenn die Quelle eine hatte
	if [ -e "$(lbb_p "$1")/config/system/loxberryid.cfg" ]; then
		META_HAS_LOXBERRYID=1
	else
		META_HAS_LOXBERRYID=0
	fi
}

# Setzt die META_*-Variablen aus meta.json. Trenner \037, damit leere Werte nichts verschieben.
meta_read_json() {
	local k v
	while IFS=$'\037' read -r k v; do
		printf -v "META_$k" '%s' "$v"
	done < <(jq -r '[
		["FORMAT", .format], ["OS_ID", .os.id], ["OS_VERSION_ID", .os.version_id],
		["OS_CODENAME", .os.codename], ["DEBIAN_VERSION", .os.debian_version], ["ARCH", .arch],
		["LB_VERSION", .loxberry.version], ["LB_HOMEDIR", .loxberry.homedir], ["HOSTNAME", .hostname],
		["PAYLOAD_BYTES", .sizes.payload_bytes], ["HAS_LOXBERRYID", .has_loxberryid]
	][] | map(if . == null then "" else tostring end) | join("\u001f")' "$1")
}

# V0: mindestens Debian 13 und LoxBerry 4
meta_check_v0() {
	local os="${META_OS_VERSION_ID%%.*}" lb="${META_LB_VERSION%%.*}"
	[[ "$os" =~ ^[0-9]+$ && "$lb" =~ ^[0-9]+$ ]] || return 1
	[ "$os" -ge 13 ] && [ "$lb" -ge 4 ]
}

meta_write_json() {
	local out="$1" db="$2" plugins='[]'
	if [ -r "$db" ]; then
		plugins="$(jq '[.plugins | to_entries[] | {
			md5: .key,
			folder: .value.folder,
			name: .value.name,
			version: .value.version,
			autoupdate: ((.value.autoupdate // "0") | tostring),
			has_release: ((.value.releasecfg // "") != ""),
			has_prerelease: ((.value.prereleasecfg // "") != "")
		}]' "$db")"
	fi
	jq -n \
		--arg created "$(date --iso-8601=seconds)" \
		--arg hostname "$META_HOSTNAME" \
		--arg os_id "$META_OS_ID" --arg os_ver "$META_OS_VERSION_ID" \
		--arg deb "$META_DEBIAN_VERSION" --arg codename "$META_OS_CODENAME" \
		--arg arch "$META_ARCH" --arg lbver "$META_LB_VERSION" --arg lbhome "$META_LB_HOMEDIR" \
		--arg bytes "${META_PAYLOAD_BYTES:-0}" --arg hasid "${META_HAS_LOXBERRYID:-0}" \
		--argjson plugins "$plugins" \
		'{format: 1, created: $created, hostname: $hostname,
		  os: {id: $os_id, version_id: $os_ver, debian_version: $deb, codename: $codename},
		  arch: $arch, loxberry: {version: $lbver, homedir: $lbhome},
		  plugins: $plugins, sizes: {payload_bytes: ($bytes | tonumber)},
		  has_loxberryid: ($hasid | tonumber)}' > "$out"
}

meta_write_sums() {
	( cd "$1" && find meta -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 -r sha256sum > meta/SHA256SUMS )
}

meta_check_sums() {
	( cd "$1" && sha256sum --quiet -c meta/SHA256SUMS > /dev/null 2>&1 )
}

# ============================================================ archive

# Clone-Archiv (7z Standard, zip, tar.gz). Aufbau – unter Windows wie Linux entpackbar:
#
#   lbclone          dieses Skript (eine Datei)
#   loxberry.tar     der eigentliche Clone (bei Verschlüsselung loxberry.tar.gpg)
#
# loxberry.tar bleibt beim Entpacken ein tar: nur tar bewahrt Eigentümer und Rechte.
# Sein erstes Member ist meta.tar (Manifest), danach die Payload relativ zu /.
# Lesen geht aus dem ganzen Archiv oder direkt aus einem entpackten loxberry.tar[.gpg].

LBB_INNER=loxberry.tar

# Endung des äußeren Archivs: archive_ext <7z|zip|gz>
archive_ext() {
	case "$1" in
		zip) echo zip ;;
		gz) echo tar.gz ;;
		*) echo 7z ;;
	esac
}

# Werkzeug für eine Kompression bzw. ein Archiv (Format für lbb_ensure_tools)
archive_tools() {
	case "$1" in
		7z|zip|*.7z|*.zip) echo 7z:7zip ;;
		gz|*.tar.gz) echo gzip:gzip ;;
		*) echo tar:tar ;;
	esac
}

# Name des inneren Clones in einem äußeren Archiv (…/loxberry.tar oder …/loxberry.tar.gpg)
_arch_member() {
	case "$1" in
		*.7z|*.zip)
			7z l -ba "$1" 2>/dev/null | awk '{print $NF}' | grep -m1 -E "(^|/)$LBB_INNER(\.gpg)?$"
			;;
		*.tar.gz)
			gzip -dc "$1" 2>/dev/null | tar -tf - 2>/dev/null | grep -m1 -E "(^|/)$LBB_INNER(\.gpg)?$"
			;;
		*) basename "$1" ;;
	esac
}

archive_is_encrypted() {
	case "$(_arch_member "$1")" in *.gpg) return 0 ;; esac
	return 1
}

# Ohne Passphrase-Datei würde gpg auf eine Eingabe warten, die nie kommt
archive_require_pass() {
	if archive_is_encrypted "$1" && { [ -z "${2:-}" ] || [ "$2" = "-" ]; }; then
		die 2 "Der Clone ist verschlüsselt: --passphrase-file angeben."
	fi
}

# archive_create <ausgabe> <arbeitsordner> <7z|zip|gz> <passfile|-> <exclude-datei> <payload-liste> [zwischenablage]
# Status 0 ok, 1 Warnung von tar, 3 Fehler (dann ist <ausgabe> gelöscht).
archive_create() {
	local out="$1" work="$2" comp="$3" pass="$4" excl="$5" list="$6" stage="${7:-}" line rc inner
	local -a snap=() dumps=() verbose=()
	inner="$LBB_INNER"
	[ "$pass" != "-" ] && inner="$inner.gpg"
	# Momentaufnahmen: nur die in snap.list genannten Pfade, ohne ihre Elternverzeichnisse
	if [ -s "$work/snap.list" ]; then
		snap=(-C "$work/snap" --files-from="$work/snap.list")
	fi
	# Datenbank-Dumps (Zwischenablage auf dem Zielmedium) als dumps/…
	if [ -n "$stage" ] && [ -d "$stage/dumps" ]; then
		dumps=(-C "$stage" dumps)
	fi
	if [ "${LBB_VERBOSE:-0}" = 1 ]; then
		verbose=(--verbose --index-file="$work/tar-index.txt")
	fi
	# Das Werkzeug (dieses Skript) ins Wurzelverzeichnis des Archivs
	rm -rf "$work/pkg"
	mkdir -p "$work/pkg"
	install -m 755 "$LBB_SELF" "$work/pkg/lbclone" || return 3
	rm -f "$out"
	(
		umask 077
		_arch_inner_stream() {
			tar --create --file=- --format=gnu "${verbose[@]}" \
				--warning=no-file-changed --warning=no-file-removed --ignore-failed-read \
				--anchored --exclude-from="$excl" \
				-C "$work" meta.tar "${snap[@]}" "${dumps[@]}" \
				-C "$(lbb_p /)" --files-from="$list" \
				2> "$work/tar-warnings.txt"
			echo "$?" > "$work/tar-status"
		}
		_arch_encrypt() {
			if [ "$pass" != "-" ]; then
				gpg --batch --yes --quiet --pinentry-mode loopback --passphrase-file "$pass" --symmetric --cipher-algo AES256 -o -
			else
				cat
			fi
		}
		case "$comp" in
			gz)
				# tar.gz braucht die Größe von loxberry.tar vorab: Zwischendatei auf dem Zielmedium
				tmp="$(mktemp -d "$(dirname "$out")/.lbclone-gz.XXXXXX")" || exit 3
				trap 'rm -rf "$tmp"' EXIT
				cp -p "$work/pkg/lbclone" "$tmp/"
				_arch_inner_stream | _arch_encrypt > "$tmp/$inner" || exit 3
				tar -C "$tmp" -cf - lbclone "$inner" | gzip -c > "$out" || exit 3
				;;
			*)
				t=7z
				[ "$comp" = zip ] && t=zip
				( cd "$work/pkg" && 7z a -t"$t" -bd -bso0 -bsp0 "$out" lbclone ) || exit 3
				_arch_inner_stream | _arch_encrypt | 7z a -t"$t" -bd -bso0 -bsp0 -si"$inner" "$out"
				st=("${PIPESTATUS[@]}")
				[ "${st[1]}" = 0 ] && [ "${st[2]}" = 0 ] || exit 3
				;;
		esac
		case "$(cat "$work/tar-status" 2>/dev/null)" in
			0) exit 0 ;;
			1) exit 1 ;;
			*) exit 3 ;;
		esac
	)
	rc=$?
	[ "$rc" -ge 3 ] && rm -f "$out"
	if [ -s "$work/tar-index.txt" ]; then
		while IFS= read -r line; do
			log_debug "  + $line"
		done < "$work/tar-index.txt"
	fi
	return "$rc"
}

# Inneres loxberry.tar als tar-Strom auf stdout: archive_stream <datei> <passfile|->
# <datei> ist das ganze Archiv (7z, zip, tar.gz) oder ein entpacktes loxberry.tar[.gpg].
archive_stream() {
	local f="$1" pass="${2:--}" member
	member="$(_arch_member "$f")"
	[ -n "$member" ] || { log_err "Kein $LBB_INNER in $f gefunden."; return 2; }
	(
		set -o pipefail
		case "$f" in
			*.7z|*.zip) 7z x -so -bd "$f" "$member" 2>/dev/null ;;
			*.tar.gz) gzip -dc "$f" | tar -xOf - "$member" ;;
			*) cat "$f" ;;
		esac | if [ "${member%.gpg}" != "$member" ]; then
			gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$pass" -d
		else
			cat
		fi
	)
}

# archive_read_meta <datei> <passfile|-> <ziel> – liest nur das erste Member (meta.tar)
archive_read_meta() {
	mkdir -p "$3"
	archive_stream "$1" "$2" 2>/dev/null | tar -x -O --occurrence=1 -f - meta.tar 2>/dev/null | tar -x -C "$3" -f -
	[ -r "$3/meta/meta.json" ]
}

# archive_extract <datei> <passfile|-> <ziel> [tar-optionen/member…]
archive_extract() {
	local a="$1" p="$2" dest="$3"
	shift 3
	local -a own=() verbose=()
	if [ "$EUID" -eq 0 ]; then
		own=(--same-owner --same-permissions)
	fi
	if [ "${LBB_VERBOSE:-0}" = 1 ]; then
		verbose=(--verbose)
	fi
	archive_stream "$a" "$p" | tar -x -f - -C "$dest" "${own[@]}" "${verbose[@]}" --exclude=meta.tar "$@"
	local -a st=("${PIPESTATUS[@]}")
	[ "${st[0]}" = 0 ] || return "${st[0]}"
	return "${st[1]}"
}

# archive_verify <datei> <passfile|-> <arbeitsordner>
archive_verify() {
	local a="$1" p="$2" work="$3"
	# Das ganze Archiv, auch der Werkzeug-Teil – ein kaputtes lbclone/ nützt beim Restore nichts
	case "$a" in
		*.7z|*.zip) 7z t -bd -bso0 -bsp0 "$a" > /dev/null 2>&1 || return 1 ;;
		*.tar.gz) gzip -t "$a" 2>/dev/null || return 1 ;;
	esac
	archive_stream "$a" "$p" | tar -t -f - > /dev/null
	local -a st=("${PIPESTATUS[@]}")
	[ "${st[0]}" = 0 ] && [ "${st[1]}" = 0 ] || return 1
	archive_read_meta "$a" "$p" "$work" || return 1
	meta_check_sums "$work"
}

